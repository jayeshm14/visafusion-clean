<?xml version="1.0" encoding="utf-8"?>
<!--
  VisaFusion NuGet configuration (SPEC-0003 Target Architecture, Phase 2).

  - nuget.org is the primary source for third-party packages (Serilog,
    OpenTelemetry, etc.). Added as a repo-level source because the machine
    defaults do not include it.
  - The Visual Studio Offline Packages source is retained as a fallback for
    environments with no network access.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Microsoft Visual Studio Offline Packages" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\" />
  </packageSources>
</configuration>
