@model VisaFusion.Web.Components.FormCardModel
@{
    var cardId = Model.Id ?? "form-card";
    var title = Model.Title ?? string.Empty;
    var subtitle = Model.Subtitle ?? string.Empty;
    var headerActions = Model.HeaderActions ?? new List<FormCardAction>();
    var sections = Model.Sections ?? new List<FormCardSection>();
    var footerActions = Model.FooterActions ?? new List<FormCardAction>();
    var cardClass = Model.CardClass ?? string.Empty;
    var headerClass = Model.HeaderClass ?? string.Empty;
    var bodyClass = Model.BodyClass ?? string.Empty;
    var footerClass = Model.FooterClass ?? string.Empty;
    var form = Model.Form;
}

@* FormCard Component - CoreUI Card Pattern *@
@* Maps to: CoreUI Cards (COREUI_COMPONENT_CATALOG §3.1) + Form Layout (COREUI_COMPONENT_CATALOG §6.6) *@
@* Uses: .card, .card-header, .card-body, .card-footer, .row.g-3, .col-*, .form-floating *@

<div id="@cardId" class="form-card card @cardClass" role="region" aria-labelledby="@(cardId)-title">
    @if (!string.IsNullOrEmpty(title))
    {
        <div class="card-header @headerClass d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h5 id="@(cardId)-title" class="card-title mb-0">@title</h5>
                @if (!string.IsNullOrEmpty(subtitle))
                {
                    <p class="card-subtitle text-body-secondary small mb-0">@subtitle</p>
                }
            </div>
            @if (headerActions.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var action in headerActions)
                    {
                        <a class="btn @(action.CssClass ?? "btn-sm btn-outline-secondary")" href="@action.Url" @(action.OnClick != null ? $"onclick=\"{action.OnClick}\"" : "")>
                            @if (!string.IsNullOrEmpty(action.Icon))
                            {
                                <svg class="icon icon-sm me-1" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="@action.Icon"/></svg>
                            }
                            @action.Title
                        </a>
                    }
                </div>
            }
        </div>
    }

    <div class="card-body @bodyClass">
        @if (form != null)
        {
            <form method="@form.Method" action="@form.Action" id="@(form.Id ?? cardId + "-form")" class="@form.CssClass" novalidate>
                @form.AntiForgeryToken
                @foreach (var section in sections)
                {
                    @if (!string.IsNullOrEmpty(section.Title))
                    {
                        <h6 class="form-section-title text-body-secondary text-uppercase small mb-3">@(section.Title)</h6>
                    }
                    <div class="row g-3 @(section.CssClass)">
                        @foreach (var field in section.Fields)
                        {
                            var colClass = field.ColClass ?? "col-md-6";
                            <div class="@colClass">
                                @if (field.Type == FormFieldType.Hidden)
                                {
                                    <input type="hidden" name="@field.Name" value="@field.Value" />
                                }
                                else if (field.Type == FormFieldType.Checkbox || field.Type == FormFieldType.Switch)
                                {
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="@field.Name" id="@(cardId + "-" + field.Name)" value="true" @(field.Value?.ToString() == "true" ? "checked" : "") @(field.Disabled ? "disabled" : "") @(field.Required ? "required" : "") />
                                        <label class="form-check-label" for="@(cardId + "-" + field.Name)">@field.Label</label>
                                        @if (!string.IsNullOrEmpty(field.HelpText))
                                        {
                                            <div class="form-text">@field.HelpText</div>
                                        }
                                    </div>
                                }
                                else if (field.Type == FormFieldType.Radio)
                                {
                                    <fieldset class="form-check-group">
                                        <legend class="form-label">@field.Label</legend>
                                        @foreach (var option in field.Options)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="@field.Name" id="@(cardId + "-" + field.Name + "-" + option.Value)" value="@option.Value" @(field.Value?.ToString() == option.Value ? "checked" : "") @(field.Disabled ? "disabled" : "") @(field.Required ? "required" : "") />
                                                <label class="form-check-label" for="@(cardId + "-" + field.Name + "-" + option.Value)">@option.Text</label>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(field.HelpText))
                                        {
                                            <div class="form-text">@field.HelpText</div>
                                        }
                                    </fieldset>
                                }
                                else if (field.Type == FormFieldType.CheckboxList)
                                {
                                    <fieldset class="form-check-group">
                                        <legend class="form-label">@field.Label</legend>
                                        @foreach (var option in field.Options)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="@field.Name" id="@(cardId + "-" + field.Name + "-" + option.Value)" value="@option.Value" @(field.SelectedValues?.Contains(option.Value) == true ? "checked" : "") @(field.Disabled ? "disabled" : "") />
                                                <label class="form-check-label" for="@(cardId + "-" + field.Name + "-" + option.Value)">@option.Text</label>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(field.HelpText))
                                        {
                                            <div class="form-text">@field.HelpText</div>
                                        }
                                    </fieldset>
                                }
                                else if (field.Type == FormFieldType.Select)
                                {
                                    <label for="@(cardId + "-" + field.Name)" class="form-label">@field.Label @if (field.Required) { <span class="text-danger">*</span> }</label>
                                    <select class="form-select @(field.CssClass ?? "")" name="@field.Name" id="@(cardId + "-" + field.Name)" @(field.Disabled ? "disabled" : "") @(field.Required ? "required" : "") @(field.Multiple ? "multiple" : "")>
                                        @if (!string.IsNullOrEmpty(field.Placeholder))
                                        {
                                            <option value="" disabled selected>@field.Placeholder</option>
                                        }
                                        @foreach (var option in field.Options)
                                        {
                                            <option value="@option.Value" @(field.Value?.ToString() == option.Value ? "selected" : "")>@option.Text</option>
                                        }
                                    </select>
                                    @if (!string.IsNullOrEmpty(field.HelpText))
                                    {
                                        <div class="form-text">@field.HelpText</div>
                                    }
                                    @if (field.Required)
                                    {
                                        <div class="invalid-feedback">Please select an option.</div>
                                    }
                                }
                                else if (field.Type == FormFieldType.TextArea)
                                {
                                    <label for="@(cardId + "-" + field.Name)" class="form-label">@field.Label @if (field.Required) { <span class="text-danger">*</span> }</label>
                                    <textarea class="form-control @(field.CssClass ?? "")" name="@field.Name" id="@(cardId + "-" + field.Name)" rows="@(field.Rows ?? 3)" @(field.Disabled ? "disabled" : "") @(field.Required ? "required" : "") placeholder="@field.Placeholder">@field.Value</textarea>
                                    @if (!string.IsNullOrEmpty(field.HelpText))
                                    {
                                        <div class="form-text">@field.HelpText</div>
                                    }
                                    @if (field.Required)
                                    {
                                        <div class="invalid-feedback">This field is required.</div>
                                    }
                                }
                                else if (field.Type == FormFieldType.File)
                                {
                                    <label for="@(cardId + "-" + field.Name)" class="form-label">@field.Label @if (field.Required) { <span class="text-danger">*</span> }</label>
                                    <input type="file" class="form-control @(field.CssClass ?? "")" name="@field.Name" id="@(cardId + "-" + field.Name)" @(field.Disabled ? "disabled" : "") @(field.Required ? "required" : "") @(field.Multiple ? "multiple" : "") />
                                    @if (!string.IsNullOrEmpty(field.HelpText))
                                    {
                                        <div class="form-text">@field.HelpText</div>
                                    }
                                    @if (field.Required)
                                    {
                                        <div class="invalid-feedback">Please select a file.</div>
                                    }
                                }
                                else
                                {
                                    @* Default: text input with floating label support *@
                                    var useFloating = field.UseFloatingLabel || (Model.Form?.UseFloatingLabels ?? false);
                                    if (useFloating)
                                    {
                                        <div class="form-floating">
                                            <input type="@(field.InputType ?? "text")" class="form-control @(field.CssClass ?? "") @(field.Required ? "is-required" : "")" name="@field.Name" id="@(cardId + "-" + field.Name)" value="@field.Value" @(field.Disabled ? "disabled" : "") @(field.Required ? "required" : "") placeholder="@field.Placeholder" @(field.MaxLength != null ? $"maxlength=\"{field.MaxLength}\"" : "") @(field.Min != null ? $"min=\"{field.Min}\"" : "") @(field.Max != null ? $"max=\"{field.Max}\"" : "") @(field.Step != null ? $"step=\"{field.Step}\"" : "") @(field.Pattern != null ? $"pattern=\"{field.Pattern}\"" : "") />
                                            <label for="@(cardId + "-" + field.Name)">@field.Label</label>
                                        </div>
                                    }
                                    else
                                    {
                                        <label for="@(cardId + "-" + field.Name)" class="form-label">@field.Label @if (field.Required) { <span class="text-danger">*</span> }</label>
                                        <input type="@(field.InputType ?? "text")" class="form-control @(field.CssClass ?? "") @(field.Required ? "is-required" : "")" name="@field.Name" id="@(cardId + "-" + field.Name)" value="@field.Value" @(field.Disabled ? "disabled" : "") @(field.Required ? "required" : "") placeholder="@field.Placeholder" @(field.MaxLength != null ? $"maxlength=\"{field.MaxLength}\"" : "") @(field.Min != null ? $"min=\"{field.Min}\"" : "") @(field.Max != null ? $"max=\"{field.Max}\"" : "") @(field.Step != null ? $"step=\"{field.Step}\"" : "") @(field.Pattern != null ? $"pattern=\"{field.Pattern}\"" : "") />
                                    }
                                    @if (!string.IsNullOrEmpty(field.HelpText))
                                    {
                                        <div class="form-text">@field.HelpText</div>
                                    }
                                    @if (field.Required)
                                    {
                                        <div class="invalid-feedback">This field is required.</div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </form>
        }
        else
        {
            @Model.BodyContent
        }
    </div>

    @if (footerActions.Any())
    {
        <div class="card-footer @footerClass d-flex flex-wrap justify-content-end gap-2">
            @foreach (var action in footerActions)
            {
                @if (action.Type == FormCardActionType.Submit)
                {
                    <button type="submit" form="@(Model.Form?.Id ?? cardId + "-form")" class="btn @(action.CssClass ?? "btn-primary")" @(action.Disabled ? "disabled" : "")>
                        @if (!string.IsNullOrEmpty(action.Icon))
                        {
                            <svg class="icon icon-sm me-1" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="@action.Icon"/></svg>
                        }
                        @action.Title
                    </button>
                }
                else if (action.Type == FormCardActionType.Button)
                {
                    <button type="button" class="btn @(action.CssClass ?? "btn-secondary")" @(action.OnClick != null ? $"onclick=\"{action.OnClick}\"" : "") @(action.Disabled ? "disabled" : "")>
                        @if (!string.IsNullOrEmpty(action.Icon))
                        {
                            <svg class="icon icon-sm me-1" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="@action.Icon"/></svg>
                        }
                        @action.Title
                    </button>
                }
                else if (action.Type == FormCardActionType.Link)
                {
                    <a class="btn @(action.CssClass ?? "btn-link")" href="@action.Url" @(action.OnClick != null ? $"onclick=\"{action.OnClick}\"" : "")>
                        @if (!string.IsNullOrEmpty(action.Icon))
                        {
                            <svg class="icon icon-sm me-1" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="@action.Icon"/></svg>
                        }
                        @action.Title
                    </a>
                }
            }
        </div>
    }
</div>