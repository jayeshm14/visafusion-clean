@model VisaFusion.Web.Components.RoleDashboardModel
@{
    var title = Model.Title ?? "Dashboard";
    var subtitle = Model.Subtitle ?? string.Empty;
    var kpiCards = Model.KpiCards ?? new List<RoleDashboardKpiCard>();
    var charts = Model.Charts ?? new List<RoleDashboardChart>();
    var progressGroups = Model.ProgressGroups ?? new List<RoleDashboardProgressGroup>();
    var tables = Model.Tables ?? new List<RoleDashboardTable>();
    var cardClass = Model.CardClass ?? "shadow-sm";
    var headerClass = Model.HeaderClass ?? string.Empty;
    var bodyClass = Model.BodyClass ?? string.Empty;
    var footerClass = Model.FooterClass ?? string.Empty;
}

@* RoleDashboard Component - CoreUI Dashboard Pattern *@
@* Maps to: CoreUI Dashboard (COREUI_COMPONENT_CATALOG §3.1 Cards, §3.4 Progress, §7.1 Charts) *@
@* Uses: .card, .card-body, .row.g-4, .col-*, .progress, .progress-thin, .progress-group, .chart-wrapper *@

<div class="role-dashboard card @cardClass">
    @if (!string.IsNullOrEmpty(Model.HeaderHtml))
    {
        <div class="card-header @Model.HeaderClass">
            @Model.HeaderHtml
        </div>
    }
    else if (!string.IsNullOrEmpty(title))
    {
        <div class="card-header @headerClass">
            <h5 class="card-title mb-0">@title</h5>
            @if (!string.IsNullOrEmpty(subtitle))
            {
                <p class="card-subtitle text-body-secondary small mb-0">@subtitle</p>
            }
        </div>
    }

    <div class="card-body @bodyClass">
        @if (!string.IsNullOrEmpty(Model.BodyHtml))
        {
            @Html.Raw(Model.BodyHtml)
        }
        else
        {
            @* KPI Cards Row *@
            @if (kpiCards.Any())
            {
                <div class="row g-4 mb-4">
                    @foreach (var kpi in kpiCards)
                    {
                        var colClass = kpi.ColClass ?? "col-sm-6 col-xl-3";
                        <div class="@colClass">
                            <div class="card kpi-card h-100 @kpi.CardClass">
                                <div class="card-body">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <p class="card-text text-body-secondary small mb-1">@kpi.Label</p>
                                            <h3 class="card-title mb-0">@kpi.Value</h3>
                                            @if (!string.IsNullOrEmpty(kpi.Trend))
                                            {
                                                var trendIsUp = kpi.TrendStartsWith("+");
                                                var trendIsDown = kpi.TrendStartsWith("-");
                                                var trendClass = trendIsUp ? "text-success" : trendIsDown ? "text-danger" : "text-body-secondary";
                                                <p class="card-text @trendClass small mb-0">
                                                    @if (trendIsUp)
                                                    {
                                                        <svg class="icon icon-xs me-1" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.646 7.646a.5.5 0 0 1 .708 0L8 10.293l2.646-2.647a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 0 1 0-.708z"/></svg>
                                                    }
                                                    else if (trendIsDown)
                                                    {
                                                        <svg class="icon icon-xs me-1" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/></svg>
                                                    }
                                                    @kpi.Trend
                                                </p>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(kpi.Icon))
                                    {
                                        <div class="kpi-icon">
                                            <svg class="icon icon-2xl @(kpi.IconColor ?? "text-primary")" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="@kpi.Icon"/></svg>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @* Charts Row — SPEC-0009 T087: chart.js canvas containers *@
            @if (charts.Any())
            {
                <div class="row g-4 mb-4">
                    @foreach (var chart in charts)
                    {
                        var colClass = chart.ColClass ?? "col-lg-6";
                        var chartId = chart.Id ?? "chart-" + charts.IndexOf(chart);
                        var chartDataJson = System.Text.Json.JsonSerializer.Serialize(chart.Data);
                        var chartOptionsJson = System.Text.Json.JsonSerializer.Serialize(chart.Options);
                        <div class="@colClass">
                            <div class="card chart-card h-100 @chart.CardClass">
                                <div class="card-header">
                                    <h6 class="card-title mb-0">@chart.Title</h6>
                                </div>
                                <div class="card-body">
                                    <div class="chart-wrapper" style="height: @(chart.Height)px; position: relative;">
                                        <canvas id="@chartId"
                                                data-chart-type="@chart.Type"
                                                data-chart-data="@chartDataJson"
                                                data-chart-options="@chartOptionsJson"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @* Progress Groups *@
            @if (progressGroups.Any())
            {
                <div class="mb-4">
                    @foreach (var group in progressGroups)
                    {
                        <div class="progress-group mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-medium">@group.Label</span>
                                <span class="text-body-secondary">@group.Value</span>
                            </div>
                            <div class="progress @(group.Thin ? "progress-thin" : "")" style="height: @(group.Height)px;" role="progressbar" aria-valuenow="@group.Value" aria-valuemin="0" aria-valuemax="@group.Max" aria-label="@group.Label">
                                <div class="progress-bar @group.ColorClass" style="width: @group.Percentage%"></div>
                            </div>
                            @if (!string.IsNullOrEmpty(group.SubLabel))
                            {
                                <div class="text-body-secondary small mt-1">@group.SubLabel</div>
                            }
                        </div>
                    }
                </div>
            }

            @* Tables *@
            @if (tables.Any())
            {
                @foreach (var table in tables)
                {
                    <div class="table-responsive mb-4">
                        @await Html.PartialAsync("_DataTable", table.Table)
                    </div>
                }
            }
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.FooterHtml))
    {
        <div class="card-footer @footerClass">
            @Model.FooterHtml
        </div>
    }
</div>