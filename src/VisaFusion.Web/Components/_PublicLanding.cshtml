@model VisaFusion.Web.Components.PublicLandingModel
@{
    var title = Model.Title ?? "Welcome to VisaFusion";
    var subtitle = Model.Subtitle ?? "Your trusted visa processing partner";
    var hero = Model.Hero;
    var features = Model.Features ?? new List<PublicLandingFeature>();
    var stats = Model.Stats ?? new List<PublicLandingStat>();
    var cta = Model.CallToAction;
}

@* PublicLanding Component - CoreUI Landing Page Pattern *@
@* Maps to: CoreUI Dashboard (COREUI_COMPONENT_CATALOG §3.1, §3.4) *@
@* Uses: .card, .card-body, .row.g-4, .col-*, .display-*, .btn, .progress *@

<div class="public-landing container-lg px-4 py-5">
    @if (hero != null)
    {
        <div class="text-center mb-5">
            @if (!string.IsNullOrEmpty(hero.Icon))
            {
                <svg class="icon icon-3xl text-primary mb-3" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="@hero.Icon"/></svg>
            }
            <h1 class="display-3 fw-bold mb-3">@hero.Title</h1>
            @if (!string.IsNullOrEmpty(hero.Subtitle))
            {
                <p class="lead text-body-secondary mb-4">@hero.Subtitle</p>
            }
            @if (hero.Actions.Any())
            {
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    @foreach (var action in hero.Actions)
                    {
                        <a class="btn @(action.CssClass ?? "btn-primary btn-lg")" href="@action.Url" @(action.OnClick != null ? $"onclick=\"{action.OnClick}\"" : "")>
                            @if (!string.IsNullOrEmpty(action.Icon))
                            {
                                <svg class="icon icon-sm me-2" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="@action.Icon"/></svg>
                            }
                            @action.Title
                        </a>
                    }
                </div>
            }
        </div>
    }

    @if (stats.Any())
    {
        <div class="row g-4 mb-5">
            @foreach (var stat in stats)
            {
                var colClass = stat.ColClass ?? "col-6 col-md-3";
                <div class="@colClass">
                    <div class="card stat-card h-100 @stat.CardClass">
                        <div class="card-body text-center py-4">
                            <div class="stat-icon mb-3">
                                @if (!string.IsNullOrEmpty(stat.Icon))
                                {
                                    <svg class="icon icon-2xl text-primary" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="@stat.Icon"/></svg>
                                }
                            </div>
                            <div class="stat-value display-4 fw-bold text-primary mb-1">@stat.Value</div>
                            <div class="stat-label text-body-secondary small">@stat.Label</div>
                            @if (!string.IsNullOrEmpty(stat.Description))
                            {
                                <div class="text-body-tertiary small mt-1">@stat.Description</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (features.Any())
    {
        <h2 class="h4 mb-4 text-center">@(Model.FeaturesTitle ?? "Our Services")</h2>
        <div class="row g-4 mb-5">
            @foreach (var feature in features)
            {
                var colClass = feature.ColClass ?? "col-md-6 col-lg-4";
                <div class="@colClass">
                    <div class="card feature-card h-100 @feature.CardClass">
                        <div class="card-body p-4 text-center">
                            @if (!string.IsNullOrEmpty(feature.Icon))
                            {
                                <div class="feature-icon mb-3">
                                    <svg class="icon icon-2xl text-primary" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="@feature.Icon"/></svg>
                                </div>
                            }
                            <h5 class="card-title">@feature.Title</h5>
                            <p class="card-text text-body-secondary small">@feature.Description</p>
                            @if (feature.Actions.Any())
                            {
                                <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
                                    @foreach (var action in feature.Actions)
                                    {
                                        <a class="btn @(action.CssClass ?? "btn-sm btn-outline-primary")" href="@action.Url" @(action.OnClick != null ? $"onclick=\"{action.OnClick}\"" : "")>
                                            @if (!string.IsNullOrEmpty(action.Icon))
                                            {
                                                <svg class="icon icon-sm me-1" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="@action.Icon"/></svg>
                                            }
                                            @action.Title
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (cta != null)
    {
        <div class="card @cta.CardClass mb-5">
            <div class="card-body p-5 text-center">
                <h3 class="card-title mb-3">@cta.Title</h3>
                @if (!string.IsNullOrEmpty(cta.Description))
                {
                    <p class="lead text-body-secondary mb-4">@cta.Description</p>
                }
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    @foreach (var action in cta.Actions)
                    {
                        <a class="btn @(action.CssClass ?? "btn-primary btn-lg")" href="@action.Url" @(action.OnClick != null ? $"onclick=\"{action.OnClick}\"" : "")>
                            @if (!string.IsNullOrEmpty(action.Icon))
                            {
                                <svg class="icon icon-sm me-2" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="@action.Icon"/></svg>
                            }
                            @action.Title
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>