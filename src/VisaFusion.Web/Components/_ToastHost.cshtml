@model VisaFusion.Web.Components.ToastHostModel
@{
    var containerId = Model.ContainerId ?? "toast-container";
    var position = Model.Position ?? "top-end";
    var autoHide = Model.AutoHide;
    var delay = Model.Delay;
    var animation = Model.Animation;
    var maxToasts = Model.MaxToasts;
}

@* ToastHost Component - CoreUI Toast Pattern *@
@* Maps to: CoreUI Toasts (COREUI_COMPONENT_CATALOG §4.2) *@
@* Uses: .toast-container, .toast, .toast-header, .toast-body, .btn-close *@

<div id="@containerId" class="toast-host toast-container position-fixed @position p-3" aria-live="polite" aria-atomic="true" style="z-index: 1080; max-width: 350px;">
    @* Toast templates will be dynamically inserted here *@
</div>

<script>
(function() {
    // ToastHost - Global toast notification system
    window.VisaFusion = window.VisaFusion || {};
    window.VisaFusion.toastHost = {
        containerId: '@containerId',
        position: '@position',
        autoHide: @autoHide.ToString().ToLower(),
        delay: @delay,
        animation: @animation.ToString().ToLower(),
        maxToasts: @maxToasts,
        toasts: [],

        // Show a toast notification
        show: function(options) {
            const container = document.getElementById(this.containerId);
            if (!container) return;

            // Limit number of toasts
            if (this.toasts.length >= this.maxToasts) {
                this.hide(this.toasts[0].id);
            }

            const id = 'toast-' + Date.now() + '-' + Math.random().toString(36).substr(2, 9);
            const toast = this.createToast(id, options);
            this.toasts.push({ id, element: toast, timeout: null });

            container.appendChild(toast);

            // Initialize CoreUI toast
            const bsToast = new coreui.Toast(toast, {
                autohide: this.autoHide,
                delay: this.delay,
                animation: this.animation
            });
            bsToast.show();

            // Auto-remove after hide
            toast.addEventListener('hidden.bs.toast', () => {
                this.removeToast(id);
            });

            return id;
        },

        createToast: function(id, options) {
            const toast = document.createElement('div');
            toast.id = id;
            toast.className = 'toast @(Model.Animation ? "fade" : "")';
            toast.role = 'alert';
            toast.ariaLive = 'assertive';
            toast.ariaAtomic = 'true';
            toast.setAttribute('data-coreui-autohide', '@autoHide.ToString().ToLower()');
            toast.setAttribute('data-coreui-delay', '@delay');

            const headerClass = this.getHeaderClass(options.type);
            const icon = this.getIcon(options.type);

            toast.innerHTML = `
                <div class="toast-header ${headerClass}">
                    ${icon ? `<svg class="icon icon-sm me-2" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="${icon}"/></svg>` : ''}
                    <strong class="me-auto">${this.escapeHtml(options.title || 'Notification')}</strong>
                    <small class="text-body-secondary">${this.formatTime(new Date())}</small>
                    <button type="button" class="btn-close btn-close-white" data-coreui-dismiss="toast" aria-label="Close"></button>
                </div>
                <div class="toast-body">
                    ${this.escapeHtml(options.message || '')}
                </div>
            `;

            return toast;
        },

        getHeaderClass: function(type) {
            switch (type) {
                case 'success': return 'bg-success text-white';
                case 'error': return 'bg-danger text-white';
                case 'warning': return 'bg-warning text-dark';
                case 'info': return 'bg-info text-dark';
                default: return 'bg-primary text-white';
            }
        },

        getIcon: function(type) {
            switch (type) {
                case 'success': return 'M16 8a8 8 0 1 1-16 0A8 8 0 0 1 16 8zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-3.75a.75.75 0 0 0-.094-1.14z';
                case 'error': return 'M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646a.5.5 0 0 0-.708 0z';
                case 'warning': return 'M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm0 12a1 1 0 1 1 0-2 1 1 0 0 1 0 2z';
                case 'info': return 'M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z';
                default: return 'M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z';
            }
        },

        formatTime: function(date) {
            return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        },

        escapeHtml: function(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        },

        hide: function(id) {
            const toast = this.toasts.find(t => t.id === id);
            if (toast && toast.element) {
                const bsToast = coreui.Toast.getInstance(toast.element);
                if (bsToast) bsToast.hide();
            }
        },

        removeToast: function(id) {
            const index = this.toasts.findIndex(t => t.id === id);
            if (index !== -1) {
                const toast = this.toasts[index];
                if (toast.timeout) clearTimeout(toast.timeout);
                if (toast.element && toast.element.parentNode) {
                    toast.element.parentNode.removeChild(toast.element);
                }
                this.toasts.splice(index, 1);
            }
        },

        // Convenience methods
        success: function(title, message, options = {}) {
            return this.show({ type: 'success', title, message, ...options });
        },
        error: function(title, message, options = {}) {
            return this.show({ type: 'error', title, message, ...options });
        },
        warning: function(title, message, options = {}) {
            return this.show({ type: 'warning', title, message, ...options });
        },
        info: function(title, message, options = {}) {
            return this.show({ type: 'info', title, message, ...options });
        },

        clear: function() {
            this.toasts.forEach(t => this.hide(t.id));
        }
    };

    // Expose globally
    window.showToast = window.VisaFusion.toastHost.show.bind(window.VisaFusion.toastHost);
    window.toastSuccess = window.VisaFusion.toastHost.success.bind(window.VisaFusion.toastHost);
    window.toastError = window.VisaFusion.toastHost.error.bind(window.VisaFusion.toastHost);
    window.toastWarning = window.VisaFusion.toastHost.warning.bind(window.VisaFusion.toastHost);
    window.toastInfo = window.VisaFusion.toastHost.info.bind(window.VisaFusion.toastHost);
})();
</script>