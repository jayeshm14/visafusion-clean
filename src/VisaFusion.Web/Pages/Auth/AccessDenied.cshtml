@page
@model VisaFusion.Web.Pages.Auth.AccessDeniedModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Access denied";
    Layout = "_AuthLayout";

    // Authenticated-but-unauthorized requests land here via the cookie
    // scheme's AccessDeniedPath (Program.cs). Server-side role denial is the
    // control — this is presentation only (AccessDeniedModel).
    var errorPage = new ErrorPageModel
    {
        ErrorCode = 403,
        Title = "Access denied",
        Message = "You do not have permission to view this page. Contact your administrator if you believe this is an error.",
        Actions = new List<ErrorPageAction>
        {
            new() { Title = "Back to home", Url = "/", CssClass = "btn-primary" }
        }
    };
}
<partial name="~/Components/_ErrorPage.cshtml" model="errorPage" />