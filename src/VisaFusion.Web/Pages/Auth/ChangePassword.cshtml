@page
@model VisaFusion.Web.Pages.Auth.ChangePasswordModel
@using Microsoft.AspNetCore.Html
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Change password";
    Layout = "_AuthLayout";

    // Inline outcome mirroring the legacy `changepassword.asp?flag=1|2|3`
    // (ChangePasswordModel.OnPostAsync) plus the policy-violation outcome.
    var resultHtml = Model.ResultMessage is not null
        ? $"<div class=\"alert alert-info\" role=\"alert\">{Model.ResultMessage}</div>"
        : string.Empty;

    var authCard = new AuthCardModel
    {
        Id = "change-password-card",
        Title = "Change password",
        Subtitle = "Update your account password",
        HeaderHtml = resultHtml,
        ValidationSummary = Html.ValidationSummary(true),
        Form = new AuthCardForm
        {
            Id = "change-password-form",
            Method = "post",
            AntiForgeryToken = Html.AntiForgeryToken()
        },
        Fields = new List<AuthCardField>
        {
            new() { Name = "CurrentPassword", Label = "Current password", Type = FormFieldType.Password, Value = string.Empty, Placeholder = "Current password", Autocomplete = "current-password", Required = true },
            new() { Name = "NewPassword", Label = "New password", Type = FormFieldType.Password, Value = string.Empty, Placeholder = "New password", Autocomplete = "new-password", Required = true },
            new() { Name = "ConfirmPassword", Label = "Confirm new password", Type = FormFieldType.Password, Value = string.Empty, Placeholder = "Confirm new password", Autocomplete = "new-password", Required = true },
        },
        ShowPasswordToggle = true,
        SubmitButton = new AuthCardSubmitButton { Title = "Change password" }
    };
}
<partial name="~/Components/_AuthCard.cshtml" model="authCard" />