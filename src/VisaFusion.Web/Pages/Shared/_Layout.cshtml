@using System.Security.Claims
@using VisaFusion.Web.Services
@inject IRoleAwareNavigation NavigationService
<!DOCTYPE html>
<html lang="en" data-coreui-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VisaFusion</title>
    <link rel="stylesheet" href="~/lib/coreui/vendors/coreui.min.css" />
    <link rel="stylesheet" href="~/lib/coreui/vendors/simplebar.min.css" />
    <link rel="stylesheet" href="~/css/vf-coreui.css" />
    <link rel="stylesheet" href="~/css/vf-component-styles.css" />
</head>
<body>
    @{
        // Shell selection (SPEC-0007 T009, R-003; contracts/ui-contract.md §1):
        // admin/agent surfaces use the sidebar + topbar shell, public/auth
        // surfaces use the top-nav layout. Pages opt in with
        // ViewData["UseSidebar"] = true; authenticated pages default to the
        // sidebar shell (the admin/agent experience), anonymous pages (login,
        // register, public site) default to the top-nav.
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var useSidebar = (bool?)ViewData["UseSidebar"] ?? isAuthenticated;
        var navGroups = NavigationService.GetNavigationGroups(User);
    }

    <a class="vf-skip-link" href="#vf-content">Skip to main content</a>

    @if (useSidebar)
    {
        <div class="vf-shell">
            @* Sidebar rendered from the canonical _Sidebar partial (SPEC-0009
               T081; FR-003/AC-004) — nav content comes from the centralized
               RoleAwareNavigation service, never from per-page sections. *@
            @await Html.PartialAsync("_Sidebar", navGroups)
            <div class="vf-main">
                @await Html.PartialAsync("_Header", new { User = User, IsAuthenticated = isAuthenticated })
                @* Page header (title + breadcrumb) is part of the shell
                   composition (SPEC-0009 T081; Addendum §6/§12). *@
                @await Html.PartialAsync("_PageHeader")
                <main id="vf-content" class="vf-content" tabindex="-1">
                    @RenderBody()
                </main>
                @await Html.PartialAsync("_Footer")
            </div>
        </div>
    }
    else
    {
        @await Html.PartialAsync("_Header", new { User = User, IsAuthenticated = isAuthenticated })
        <main id="vf-content" tabindex="-1">
            <div class="vf-content">
                @RenderBody()
            </div>
        </main>
        @await Html.PartialAsync("_Footer")
    }

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/lib/coreui/vendors/coreui.bundle.min.js"></script>
    <script src="~/lib/coreui/vendors/simplebar.min.js"></script>
    <script src="~/js/vf-coreui.js"></script>
</body>
</html>