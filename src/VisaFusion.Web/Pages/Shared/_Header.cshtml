@model dynamic
@using System.Security.Claims
@{
    var user = (ClaimsPrincipal)Model.User;
    var isAuthenticated = (bool)Model.IsAuthenticated;
    var userName = user.Identity?.Name;
    var role = user.FindFirstValue(ClaimTypes.Role);
}
<header class="header header-sticky p-0 mb-4">
    <div class="container-fluid border-bottom px-4">
        <div class="d-flex align-items-center justify-content-between py-3">
            <div class="d-flex align-items-center">
                <button class="btn btn-link text-body me-3 sidebar-toggler" type="button" data-coreui-toggle="unfoldable" aria-label="Toggle sidebar">
                    <svg class="icon icon-xs" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 4.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1 0-1zm0 3h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1 0-1zm0 3h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1 0-1z"/></svg>
                </button>
                <a class="header-brand" asp-page="/Index">
                    <svg class="header-brand-full" width="118" height="46" alt="VisaFusion Logo" viewBox="0 0 118 46" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <text x="0" y="34" font-family="system-ui, -apple-system, sans-serif" font-size="32" font-weight="700" fill="var(--cui-primary)">VisaFusion</text>
                    </svg>
                    <svg class="header-brand-narrow" width="46" height="46" alt="VF" viewBox="0 0 46 46" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <text x="0" y="34" font-family="system-ui, -apple-system, sans-serif" font-size="32" font-weight="700" fill="var(--cui-primary)">VF</text>
                    </svg>
                </a>
            </div>
            <div class="d-flex align-items-center">
                @if (isAuthenticated)
                {
                    <div class="dropdown me-3">
                        <button class="btn btn-link text-body p-0 dropdown-toggle" type="button" data-coreui-toggle="dropdown" aria-expanded="false" aria-label="Theme">
                            <svg class="icon icon-lg" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 1a5 5 0 1 0 0-10 5 5 0 0 0 0 10z"/></svg>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#" data-coreui-theme-value="light"><svg class="icon icon-sm me-2" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 1a5 5 0 1 0 0-10 5 5 0 0 0 0 10z"/></svg>Light</a></li>
                            <li><a class="dropdown-item" href="#" data-coreui-theme-value="dark"><svg class="icon icon-sm me-2" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z"/></svg>Dark</a></li>
                            <li><a class="dropdown-item" href="#" data-coreui-theme-value="auto"><svg class="icon icon-sm me-2" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 1a5 5 0 1 0 0-10 5 5 0 0 0 0 10z"/></svg>Auto</a></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-link text-body p-0 dropdown-toggle d-flex align-items-center" type="button" data-coreui-toggle="dropdown" aria-expanded="false">
                            <div class="avatar me-2">
                                <span class="avatar-initial rounded-circle bg-primary text-white">@(string.IsNullOrEmpty(userName) ? "U" : userName[0].ToString().ToUpper())</span>
                            </div>
                            <span class="d-none d-md-inline me-2">@userName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">@userName</h6></li>
                            <li><span class="dropdown-item-text">@role</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-page="/Auth/ChangePassword">Change password</a></li>
                            <li><form method="post" asp-page="/Auth/Logout"><button type="submit" class="dropdown-item">Sign out</button></form></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-primary me-2" asp-page="/Auth/Login">Log in</a>
                    <a class="btn btn-sm btn-primary" asp-page="/Auth/Register">Register</a>
                }
            </div>
        </div>
    </div>
</header>