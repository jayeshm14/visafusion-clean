@model IEnumerable<VisaFusion.Web.Services.NavigationGroup>
@{
    var groups = Model ?? Enumerable.Empty<VisaFusion.Web.Services.NavigationGroup>();
}
<aside class="sidebar sidebar-dark sidebar-fixed border-end" id="sidebar" aria-label="Primary navigation">
    <div class="sidebar-header d-flex align-items-center justify-content-between px-3 py-3 border-bottom">
        <a class="sidebar-brand d-flex align-items-center" asp-page="/Index">
            <svg class="sidebar-brand-full" width="118" height="46" alt="VisaFusion Logo" viewBox="0 0 118 46" fill="none" xmlns="http://www.w3.org/2000/svg">
                <text x="0" y="34" font-family="system-ui, -apple-system, sans-serif" font-size="32" font-weight="700" fill="var(--cui-primary)">VisaFusion</text>
            </svg>
            <svg class="sidebar-brand-narrow" width="46" height="46" alt="VF" viewBox="0 0 46 46" fill="none" xmlns="http://www.w3.org/2000/svg">
                <text x="0" y="34" font-family="system-ui, -apple-system, sans-serif" font-size="32" font-weight="700" fill="var(--cui-primary)">VF</text>
            </svg>
        </a>
        <button class="btn btn-link text-body d-lg-none sidebar-toggler" type="button" data-coreui-toggle="unfoldable" aria-label="Close sidebar">
            <svg class="icon icon-lg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="~/icons/cil/free-symbol-defs.svg#cui-x"/></svg>
        </button>
    </div>
    <nav class="sidebar-nav" data-coreui="navigation" data-simplebar aria-label="Main navigation">
        <ul class="nav flex-column">
            @foreach (var group in groups)
            {
                <li class="nav-item">
                    @if (group.IsDivider)
                    {
                        <hr class="nav-divider" />
                    }
                    else if (group.IsTitle)
                    {
                        <span class="nav-title">@group.Title</span>
                    }
                    else if (group.Children.Any())
                    {
                        <a class="nav-group" href="#" data-coreui-toggle="collapse" role="button" aria-expanded="false" aria-controls="@group.Id">
                            <svg class="icon icon-sm me-2" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="~/icons/cil/free-symbol-defs.svg#@group.Icon"/></svg>
                            @group.Title
                            <svg class="icon icon-sm ms-auto" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="~/icons/cil/free-symbol-defs.svg#cui-chevron-bottom"/></svg>
                        </a>
                        <ul class="nav flex-column collapse" id="@group.Id" data-coreui-parent="#sidebar">
                            @foreach (var child in group.Children)
                            {
                                if (child.Children.Any())
                                {
                                    <li class="nav-item">
                                        <a class="nav-group" href="#" data-coreui-toggle="collapse" role="button" aria-expanded="false" aria-controls="@child.Id">
                                            @child.Title
                                            <svg class="icon icon-sm ms-auto" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="~/icons/cil/free-symbol-defs.svg#cui-chevron-bottom"/></svg>
                                        </a>
                                        <ul class="nav flex-column collapse" id="@child.Id">
                                            @foreach (var sub in child.Children)
                                            {
                                                <li class="nav-item">
                                                    <a class="nav-link" href="@sub.Route">@sub.Title</a>
                                                </li>
                                            }
                                        </ul>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" href="@child.Route">@child.Title</a>
                                    </li>
                                }
                            }
                        </ul>
                    }
                    else
                    {
                        <a class="nav-link" href="@group.Route">
                            <svg class="icon icon-sm me-2" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="~/icons/cil/free-symbol-defs.svg#@group.Icon"/></svg>
                            @group.Title
                        </a>
                    }
                </li>
            }
        </ul>
    </nav>
    <div class="sidebar-footer border-top p-3">
        <button class="btn btn-link text-body w-100 sidebar-toggler" type="button" data-coreui-toggle="unfoldable" aria-label="Toggle sidebar">
            <span class="d-flex align-items-center justify-content-center">
                <svg class="icon icon-sm" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="~/icons/cil/free-symbol-defs.svg#cui-chevron-double-left"/></svg>
                <span class="ms-2 d-none d-lg-inline">Collapse</span>
            </span>
        </button>
    </div>
</aside>
