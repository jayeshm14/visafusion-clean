@page
@model VisaFusion.Web.Areas.Reporting.Pages.DailyVisaFeeModel
@{
    ViewData["Title"] = "Daily Visa Fee";
    ViewData["UseSidebar"] = true;
}

@section SidebarNav {
    <a asp-area="Reporting" asp-page="/Pending">Pending</a>
    <a asp-area="Reporting" asp-page="/TodaySubmission">Today Submission</a>
    <a asp-area="Reporting" asp-page="/TodayCollection">Today Collection</a>
    <a asp-area="Reporting" asp-page="/TodayTransaction">Today Transaction</a>
    <a asp-area="Reporting" asp-page="/DailyVisaFee" aria-current="page">Daily Visa Fee</a>
    <a asp-area="Reporting" asp-page="/DailyBill">Daily Bill</a>
}

<div class="vf-content">
    <h1>Daily Visa Fee</h1>
    <p>Visa fees for submissions in the selected date range (defaults to today).</p>

    <form method="get" class="vf-inline-form">
        <div class="form-group">
            <label for="dateFrom">From</label>
            <input type="date" id="dateFrom" name="dateFrom" class="form-control"
                   value="@(Model.Params?.From.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="form-group">
            <label for="dateTo">To</label>
            <input type="date" id="dateTo" name="dateTo" class="form-control"
                   value="@(Model.Params?.To is { } to ? to.AddDays(-1).ToString("yyyy-MM-dd") : string.Empty)" />
        </div>
        <button type="submit" class="vf-btn vf-btn-primary">Filter</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ParamError))
    {
        <div class="vf-alert vf-alert-danger" role="alert">@Model.ParamError</div>
    }

    @if (Model.Rows.Count == 0)
    {
        <p>No visa fee rows in the selected range.</p>
    }
    else
    {
        <table class="vf-table">
            <thead>
                <tr>
                    <th scope="col">Ref</th>
                    <th scope="col">Invoice</th>
                    <th scope="col">Type</th>
                    <th scope="col">Passenger</th>
                    <th scope="col">Country</th>
                    <th scope="col">Submitted</th>
                    <th scope="col">Visa fee</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.Refno</td>
                        <td>@(row.Invoiceno?.ToString() ?? "—")</td>
                        <td>@(string.IsNullOrWhiteSpace(row.Invtype) ? "—" : row.Invtype)</td>
                        <td>@row.Paxname</td>
                        <td>@row.Countryname</td>
                        <td>@(row.Subdate?.ToString("dd-MMM-yyyy") ?? "—")</td>
                        <td>@(row.Visafee?.ToString("0.00") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>