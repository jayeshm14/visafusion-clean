@page
@model VisaFusion.Web.Areas.Reporting.Pages.DailyVisaFeeModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Daily Visa Fee";
    ViewData["UseSidebar"] = true;

    var dataTable = new DataTableModel
    {
        Id = "daily-visa-fee-table",
        AriaLabel = "Daily visa fee report",
        Columns = new List<DataTableColumn>
        {
            new() { Key = "Refno", Title = "Ref", Width = "80px" },
            new() { Key = "Invoiceno", Title = "Invoice", Width = "100px" },
            new() { Key = "Invtype", Title = "Type", Width = "auto" },
            new() { Key = "Paxname", Title = "Passenger", Width = "auto" },
            new() { Key = "Countryname", Title = "Country", Width = "auto" },
            new() { Key = "Subdate", Title = "Submitted", Width = "140px",
                Formatter = (v) => v is DateTime dt ? dt.ToString("dd-MMM-yyyy") : (v?.ToString() ?? "—") },
            new() { Key = "Visafee", Title = "Visa fee", Width = "120px", CellClass = "text-end",
                Formatter = (v) => v is decimal d ? d.ToString("0.00") : (v?.ToString() ?? "—") }
        },
        Rows = Model.Rows.Select(r => new Dictionary<string, object>
        {
            ["Refno"] = r.Refno ?? 0,
            ["Invoiceno"] = r.Invoiceno ?? 0,
            ["Invtype"] = r.Invtype ?? "—",
            ["Paxname"] = r.Paxname ?? "—",
            ["Countryname"] = r.Countryname ?? "—",
            ["Subdate"] = r.Subdate ?? (object)DBNull.Value,
            ["Visafee"] = r.Visafee ?? 0m
        }).ToList(),
        ShowPagination = false,
        EmptyMessage = "No visa fee rows in the selected range.",
        Responsive = true
    };
}

<p class="text-body-secondary">Visa fees for submissions in the selected date range (defaults to today).</p>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end" novalidate>
            <div class="col-auto">
                <label for="dateFrom" class="form-label">From</label>
                <input type="date" id="dateFrom" name="dateFrom" class="form-control"
                       value="@(Model.Params?.From.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-auto">
                <label for="dateTo" class="form-label">To</label>
                <input type="date" id="dateTo" name="dateTo" class="form-control"
                       value="@(Model.Params?.To.HasValue == true ? Model.Params!.To.Value.AddDays(-1).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-auto">
                <label for="agentId" class="form-label">Agent ID (optional)</label>
                <input type="number" id="agentId" name="agentId" class="form-control"
                       value="@(Model.Params?.AgentId?.ToString())" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ParamError))
{
    <div class="alert alert-danger" role="alert">@Model.ParamError</div>
}

<partial name="~/Components/_DataTable.cshtml" model="dataTable" />