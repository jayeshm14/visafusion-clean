@page
@model VisaFusion.Web.Areas.Reporting.Pages.TodayCollectionModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Today Collection";
    ViewData["UseSidebar"] = true;

    var dataTable = new DataTableModel
    {
        Id = "today-collection-table",
        AriaLabel = "Today collection report",
        Columns = new List<DataTableColumn>
        {
            new() { Key = "Totalpax", Title = "Total pax", Width = "100px" },
            new() { Key = "Refno", Title = "Ref", Width = "80px" },
            new() { Key = "Colcheck", Title = "Col check", Width = "auto" },
            new() { Key = "PaxId", Title = "Pax ID", Width = "80px" },
            new() { Key = "Paxname", Title = "Passenger", Width = "auto" },
            new() { Key = "Coldate", Title = "Collection date", Width = "140px",
                Formatter = (v) => v is DateTime dt ? dt.ToString("dd-MMM-yyyy") : (v?.ToString() ?? "—") },
            new() { Key = "Subdate", Title = "Submitted", Width = "140px",
                Formatter = (v) => v is DateTime dt ? dt.ToString("dd-MMM-yyyy") : (v?.ToString() ?? "—") },
            new() { Key = "CountryId", Title = "Country ID", Width = "100px" },
            new() { Key = "StatusId", Title = "Status ID", Width = "100px" },
            new() { Key = "Remarks", Title = "Remarks", Width = "auto" },
            new() { Key = "SentDate", Title = "Sent date", Width = "140px",
                Formatter = (v) => v is DateTime dt ? dt.ToString("dd-MMM-yyyy") : (v?.ToString() ?? "—") },
            new() { Key = "Category", Title = "Category", Width = "80px" },
            new() { Key = "Receivedate", Title = "Receive date", Width = "140px",
                Formatter = (v) => v is DateTime dt ? dt.ToString("dd-MMM-yyyy") : (v?.ToString() ?? "—") },
            new() { Key = "Agent", Title = "Agent", Width = "80px" },
            new() { Key = "Internalremark", Title = "Internal remark", Width = "auto" },
            new() { Key = "Poe", Title = "POE", Width = "80px" },
            new() { Key = "Agentinstruction", Title = "Agent instruction", Width = "auto" },
            new() { Key = "Countryname", Title = "Country", Width = "auto" },
            new() { Key = "Agentname", Title = "Agent name", Width = "auto" }
        },
        Rows = Model.Rows.Select(r => new Dictionary<string, object>
        {
            ["Totalpax"] = r.Totalpax ?? 0,
            ["Refno"] = r.Refno ?? 0,
            ["Colcheck"] = r.Colcheck ?? "—",
            ["PaxId"] = r.PaxId ?? 0,
            ["Paxname"] = r.Paxname ?? "—",
            ["Coldate"] = r.Coldate ?? (object)DBNull.Value,
            ["Subdate"] = r.Subdate ?? (object)DBNull.Value,
            ["CountryId"] = r.CountryId ?? 0,
            ["StatusId"] = r.StatusId ?? 0,
            ["Remarks"] = r.Remarks ?? "—",
            ["SentDate"] = r.SentDate ?? (object)DBNull.Value,
            ["Category"] = r.Category ?? 0,
            ["Receivedate"] = r.Receivedate ?? (object)DBNull.Value,
            ["Agent"] = r.Agent ?? 0,
            ["Internalremark"] = r.Internalremark ?? "—",
            ["Poe"] = r.Poe ?? 0,
            ["Agentinstruction"] = r.Agentinstruction ?? "—",
            ["Countryname"] = r.Countryname ?? "—",
            ["Agentname"] = r.Agentname ?? "—"
        }).ToList(),
        ShowPagination = false,
        EmptyMessage = "No collection entries.",
        Responsive = true
    };
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end" novalidate>
            <div class="col-auto">
                <label for="dateFrom" class="form-label">From</label>
                <input type="date" id="dateFrom" name="dateFrom" class="form-control"
                       value="@(Model.Params?.From.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-auto">
                <label for="dateTo" class="form-label">To</label>
                <input type="date" id="dateTo" name="dateTo" class="form-control"
                       value="@(Model.Params?.To.HasValue == true ? Model.Params!.To.Value.AddDays(-1).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-auto">
                <label for="agentId" class="form-label">Agent ID (optional)</label>
                <input type="number" id="agentId" name="agentId" class="form-control"
                       value="@(Model.Params?.AgentId?.ToString())" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>
</div>

<p class="text-body-secondary">Entries whose collection date falls in the requested range (defaults to today).</p>

@if (!string.IsNullOrWhiteSpace(Model.ParamError))
{
    <div class="alert alert-danger" role="alert">@Model.ParamError</div>
}

<partial name="~/Components/_DataTable.cshtml" model="dataTable" />