@page
@model VisaFusion.Web.Areas.Reporting.Pages.PendingModel
@{
    ViewData["Title"] = "Pending List";
    ViewData["UseSidebar"] = true;
}

<p class="text-body-secondary">Entries in the pending status band (status 401–409).</p>

@if (!string.IsNullOrWhiteSpace(Model.ParamError))
{
    <div class="alert alert-danger" role="alert">@Model.ParamError</div>
}

@if (Model.Rows.Count == 0)
{
    <p>No pending entries.</p>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Ref</th>
                        <th scope="col">Passenger</th>
                        <th scope="col">Agent</th>
                        <th scope="col">Submitted</th>
                        <th scope="col">Country</th>
                        <th scope="col">External remark</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Refno</td>
                            <td>@row.Paxname</td>
                            <td>@row.Agentname</td>
                            <td>@(row.Subdate?.ToString("dd-MMM-yyyy") ?? "—")</td>
                            <td>@row.Countryname</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Externalremark) ? "—" : row.Externalremark)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}