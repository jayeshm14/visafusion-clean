@page
@model VisaFusion.Web.Areas.Reporting.Pages.TodaySubmissionModel
@{
    ViewData["Title"] = "Today Submission";
    ViewData["UseSidebar"] = true;
}

<p class="text-body-secondary">Entries submitted in the selected date range (defaults to today).</p>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-auto">
                <label for="dateFrom" class="form-label">From</label>
                <input type="date" id="dateFrom" name="dateFrom" class="form-control"
                       value="@(Model.Params?.From.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-auto">
                <label for="dateTo" class="form-label">To</label>
                <input type="date" id="dateTo" name="dateTo" class="form-control"
                       value="@(Model.Params?.To is { } to ? to.AddDays(-1).ToString("yyyy-MM-dd") : string.Empty)" />
            </div>
            <div class="col-auto">
                <label for="agentId" class="form-label">Agent ID (optional)</label>
                <input type="number" id="agentId" name="agentId" class="form-control"
                       value="@(Model.Params?.AgentId?.ToString())" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ParamError))
{
    <div class="alert alert-danger" role="alert">@Model.ParamError</div>
}

@if (Model.Rows.Count == 0)
{
    <p>No submissions in the selected range.</p>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Ref</th>
                        <th scope="col">Passenger</th>
                        <th scope="col">Agent</th>
                        <th scope="col">Country ID</th>
                        <th scope="col">Status</th>
                        <th scope="col">Submitted</th>
                        <th scope="col">Collected</th>
                        <th scope="col">Sent</th>
                        <th scope="col">Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Refno</td>
                            <td>@row.Paxname</td>
                            <td>@row.Agent</td>
                            <td>@row.CountryId</td>
                            <td>@row.StatusId</td>
                            <td>@(row.Subdate?.ToString("dd-MMM-yyyy") ?? "—")</td>
                            <td>@(row.Coldate?.ToString("dd-MMM-yyyy") ?? "—")</td>
                            <td>@(row.SentDate?.ToString("dd-MMM-yyyy") ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Remarks) ? "—" : row.Remarks)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}