@page
@model VisaFusion.Web.Areas.Reporting.Pages.TodayTransactionModel
@{
    ViewData["Title"] = "Today Transaction";
    ViewData["UseSidebar"] = true;
}

<p class="text-body-secondary">Per-reference fee totals for status rows entered in the selected date range (defaults to today).</p>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-auto">
                <label for="dateFrom" class="form-label">From</label>
                <input type="date" id="dateFrom" name="dateFrom" class="form-control"
                       value="@(Model.Params?.From.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-auto">
                <label for="dateTo" class="form-label">To</label>
                <input type="date" id="dateTo" name="dateTo" class="form-control"
                       value="@(Model.Params?.To is { } to ? to.AddDays(-1).ToString("yyyy-MM-dd") : string.Empty)" />
            </div>
            <div class="col-auto">
                <label for="agentId" class="form-label">Agent ID (optional)</label>
                <input type="number" id="agentId" name="agentId" class="form-control"
                       value="@(Model.Params?.AgentId?.ToString())" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ParamError))
{
    <div class="alert alert-danger" role="alert">@Model.ParamError</div>
}

@if (Model.Rows.Count == 0)
{
    <p>No transactions in the selected range.</p>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Ref</th>
                        <th scope="col" class="text-end">Visa fee total</th>
                        <th scope="col" class="text-end">Hotel total</th>
                        <th scope="col" class="text-end">Cab total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Refno</td>
                            <td class="text-end">@(row.VisafeeTotal?.ToString("0.00") ?? "—")</td>
                            <td class="text-end">@(row.HotelTotal?.ToString("0.00") ?? "—")</td>
                            <td class="text-end">@(row.CabTotal?.ToString("0.00") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}