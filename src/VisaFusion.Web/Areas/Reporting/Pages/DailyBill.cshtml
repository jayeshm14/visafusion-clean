@page
@model VisaFusion.Web.Areas.Reporting.Pages.DailyBillModel
@{
    ViewData["Title"] = "Daily Bill";
    ViewData["UseSidebar"] = true;
}

<p class="text-body-secondary">Bills for the selected date range (defaults to today).</p>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-auto">
                <label for="dateFrom" class="form-label">From</label>
                <input type="date" id="dateFrom" name="dateFrom" class="form-control"
                       value="@(Model.Params?.From.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-auto">
                <label for="dateTo" class="form-label">To</label>
                <input type="date" id="dateTo" name="dateTo" class="form-control"
                       value="@(Model.Params?.To is { } to ? to.AddDays(-1).ToString("yyyy-MM-dd") : string.Empty)" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ParamError))
{
    <div class="alert alert-danger" role="alert">@Model.ParamError</div>
}

@if (Model.Rows.Count == 0)
{
    <p>No bills in the selected range.</p>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Ref</th>
                        <th scope="col">Invoice</th>
                        <th scope="col">Date</th>
                        <th scope="col">Type</th>
                        <th scope="col" class="text-end">Hotel</th>
                        <th scope="col" class="text-end">Cab</th>
                        <th scope="col" class="text-end">POE</th>
                        <th scope="col" class="text-end">Misc</th>
                        <th scope="col" class="text-end">Attest</th>
                        <th scope="col" class="text-end">Courier</th>
                        <th scope="col" class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Refno</td>
                            <td>@(row.Invoiceno?.ToString() ?? "—")</td>
                            <td>@(row.Invoicedate?.ToString("dd-MMM-yyyy") ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Invtype) ? "—" : row.Invtype)</td>
                            <td class="text-end">@(row.Hotelfee?.ToString("0.00") ?? "—")</td>
                            <td class="text-end">@(row.Cabfee?.ToString("0.00") ?? "—")</td>
                            <td class="text-end">@(row.Poe?.ToString("0.00") ?? "—")</td>
                            <td class="text-end">@(row.Misc?.ToString("0.00") ?? "—")</td>
                            <td class="text-end">@(row.Attestfee?.ToString("0.00") ?? "—")</td>
                            <td class="text-end">@(row.Courierfee?.ToString("0.00") ?? "—")</td>
                            <td class="text-end">@(row.Grandtotal?.ToString("0.00") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <p class="mb-0 text-body-secondary"><strong>Grand total:</strong> @(Model.GrandTotal?.ToString("0.00") ?? "—")</p>
        </div>
    </div>
}