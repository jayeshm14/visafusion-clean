@page
@model VisaFusion.Web.Areas.Reporting.Pages.DailyBillModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Daily Bill";
    ViewData["UseSidebar"] = true;

    var dataTable = new DataTableModel
    {
        Id = "daily-bill-table",
        AriaLabel = "Daily bill report",
        Columns = new List<DataTableColumn>
        {
            new() { Key = "Refno", Title = "Ref", Width = "80px" },
            new() { Key = "Invoiceno", Title = "Invoice", Width = "100px" },
            new() { Key = "Invoicedate", Title = "Date", Width = "120px",
                Formatter = (v) => v is DateTime dt ? dt.ToString("dd-MMM-yyyy") : (v?.ToString() ?? "—") },
            new() { Key = "Invtype", Title = "Type", Width = "auto" },
            new() { Key = "Hotelfee", Title = "Hotel", Width = "120px", CellClass = "text-end",
                Formatter = (v) => v is decimal d ? d.ToString("0.00") : (v?.ToString() ?? "—") },
            new() { Key = "Cabfee", Title = "Cab", Width = "120px", CellClass = "text-end",
                Formatter = (v) => v is decimal d ? d.ToString("0.00") : (v?.ToString() ?? "—") },
            new() { Key = "Poe", Title = "POE", Width = "120px", CellClass = "text-end",
                Formatter = (v) => v is decimal d ? d.ToString("0.00") : (v?.ToString() ?? "—") },
            new() { Key = "Misc", Title = "Misc", Width = "120px", CellClass = "text-end",
                Formatter = (v) => v is decimal d ? d.ToString("0.00") : (v?.ToString() ?? "—") },
            new() { Key = "Attestfee", Title = "Attest", Width = "120px", CellClass = "text-end",
                Formatter = (v) => v is decimal d ? d.ToString("0.00") : (v?.ToString() ?? "—") },
            new() { Key = "Courierfee", Title = "Courier", Width = "120px", CellClass = "text-end",
                Formatter = (v) => v is decimal d ? d.ToString("0.00") : (v?.ToString() ?? "—") },
            new() { Key = "Grandtotal", Title = "Total", Width = "120px", CellClass = "text-end",
                Formatter = (v) => v is decimal d ? d.ToString("0.00") : (v?.ToString() ?? "—") }
        },
        Rows = Model.Rows.Select(r => new Dictionary<string, object>
        {
            ["Refno"] = r.Refno ?? 0,
            ["Invoiceno"] = r.Invoiceno ?? 0,
            ["Invoicedate"] = r.Invoicedate ?? (object)DBNull.Value,
            ["Invtype"] = r.Invtype ?? "—",
            ["Hotelfee"] = r.Hotelfee ?? 0m,
            ["Cabfee"] = r.Cabfee ?? 0m,
            ["Poe"] = r.Poe ?? 0m,
            ["Misc"] = r.Misc ?? 0m,
            ["Attestfee"] = r.Attestfee ?? 0m,
            ["Courierfee"] = r.Courierfee ?? 0m,
            ["Grandtotal"] = r.Grandtotal ?? 0m
        }).ToList(),
        ShowPagination = false,
        EmptyMessage = "No bills in the selected range.",
        Responsive = true
    };
}

<p class="text-body-secondary">Bills for the selected date range (defaults to today).</p>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end" novalidate>
            <div class="col-auto">
                <label for="dateFrom" class="form-label">From</label>
                <input type="date" id="dateFrom" name="dateFrom" class="form-control"
                       value="@(Model.Params?.From.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-auto">
                <label for="dateTo" class="form-label">To</label>
                <input type="date" id="dateTo" name="dateTo" class="form-control"
                       value="@(Model.Params?.To.HasValue == true ? Model.Params!.To.Value.AddDays(-1).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-auto">
                <label for="agentId" class="form-label">Agent ID (optional)</label>
                <input type="number" id="agentId" name="agentId" class="form-control"
                       value="@(Model.Params?.AgentId?.ToString())" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ParamError))
{
    <div class="alert alert-danger" role="alert">@Model.ParamError</div>
}

<partial name="~/Components/_DataTable.cshtml" model="dataTable" />

@if (Model.Rows.Count > 0)
{
    <div class="card shadow-sm mt-3">
        <div class="card-footer">
            <p class="mb-0 text-body-secondary"><strong>Grand total:</strong> @(Model.GrandTotal?.ToString("0.00") ?? "—")</p>
        </div>
    </div>
}