@page
@model VisaFusion.Web.Areas.Reporting.Pages.ReportingIndexModel
@using VisaFusion.Web.Components
@using System.Text
@{
    ViewData["Title"] = "Operational Reports";
    ViewData["UseSidebar"] = true;

    // Reporting landing/dashboard — SPEC-0009 T034/T037, FR-005; Addendum §7.
    // Content/data unchanged (SPEC-0008 US6, FR-012); CoreUI presentation only.
    // No KPI cards, charts or progress groups: the existing page exposes no
    // metric/chart data, and inventing any would violate the feature constraint.
    // The sidebar nav is rendered by the centralized RoleAwareNavigation service
    // (Reporting group), so no per-page SidebarNav section is defined here.
    var body = new StringBuilder();
    body.Append("<p class=\"text-body-secondary\">On-screen operational reports (SPEC-0008 US6, FR-012). Available to employee, admin and super-user roles.</p>");
    body.Append("<div class=\"card shadow-sm\">");
    body.Append("<div class=\"card-header\"><h6 class=\"card-title mb-0\">Reports</h6></div>");
    body.Append("<div class=\"list-group list-group-flush\">");
    body.Append("<a class=\"list-group-item list-group-item-action\" href=\"").Append(Url.Page("/Pending", new { area = "Reporting" })).Append("\">Pending list</a>");
    body.Append("<a class=\"list-group-item list-group-item-action\" href=\"").Append(Url.Page("/TodaySubmission", new { area = "Reporting" })).Append("\">Today submission</a>");
    body.Append("<a class=\"list-group-item list-group-item-action\" href=\"").Append(Url.Page("/TodayCollection", new { area = "Reporting" })).Append("\">Today collection</a>");
    body.Append("<a class=\"list-group-item list-group-item-action\" href=\"").Append(Url.Page("/TodayTransaction", new { area = "Reporting" })).Append("\">Today transaction</a>");
    body.Append("<a class=\"list-group-item list-group-item-action\" href=\"").Append(Url.Page("/DailyVisaFee", new { area = "Reporting" })).Append("\">Daily visa fee</a>");
    body.Append("<a class=\"list-group-item list-group-item-action\" href=\"").Append(Url.Page("/DailyBill", new { area = "Reporting" })).Append("\">Daily bill</a>");
    body.Append("</div>");
    body.Append("</div>");

    var dashboard = new RoleDashboardModel
    {
        Title = "Operational Reports",
        BodyHtml = body.ToString(),
    };
}

<partial name="~/Components/_RoleDashboard.cshtml" model="dashboard" />