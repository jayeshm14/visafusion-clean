@page
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Submit Query";

    // Public query form — SPEC-0009 T078; maps to the _PublicQueryForm
    // component (COREUI_VISA_FUSION_MAPPING.md). Posts to the public queries
    // API endpoint (/api/v1/public/queries) exactly as the legacy page did;
    // content and endpoint unchanged, CoreUI presentation only.
    var form = new PublicQueryFormModel
    {
        Title = "Submit a Query",
        Subtitle = "Please fill out the form below to submit your query.",
        Form = new PublicQueryFormForm
        {
            Id = "public-query-form",
            Action = "/api/v1/public/queries",
            Method = "post",
            AntiForgeryToken = Html.AntiForgeryToken(),
        },
        Fields = new List<PublicQueryFormField>
        {
            new() { Name = "name", Label = "Name", InputType = "text", Required = true, Autocomplete = "name" },
            new() { Name = "email", Label = "Email", InputType = "email", Required = true, Autocomplete = "email" },
            new() { Name = "subject", Label = "Subject", InputType = "text", Required = true },
            new() { Name = "message", Label = "Message", Type = FormFieldType.TextArea, Rows = 4, Required = true },
        },
        SubmitButton = new PublicQueryFormSubmitButton { Title = "Submit Query", CssClass = "btn-primary" },
        FooterHtml = "<p class=\"mb-0 text-body-secondary small\">Rate limit: 5 submissions per hour per IP address.</p>",
    };
}

<partial name="~/Components/_PublicQueryForm.cshtml" model="form" />