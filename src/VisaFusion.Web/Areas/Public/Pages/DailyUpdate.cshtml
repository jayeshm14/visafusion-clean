@page
@model VisaFusion.Web.Areas.Public.Pages.DailyUpdateModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Daily Updates";

    var dataTable = new DataTableModel
    {
        Id = "daily-update-table",
        AriaLabel = "Daily updates",
        Columns = new List<DataTableColumn>
        {
            new() { Key = "Entrydate", Title = "Date", Width = "140px",
                Formatter = (v) => v is DateTime dt ? dt.ToString("dd-MMM-yyyy") : (v?.ToString() ?? "—") },
            new() { Key = "Description", Title = "Update", Width = "auto" }
        },
        Rows = Model.Entries.Select(e => new Dictionary<string, object>
        {
            ["Entrydate"] = e.Entrydate,
            ["Description"] = e.Description
        }).ToList(),
        ShowPagination = false,
        EmptyMessage = "No updates found for this month.",
        Responsive = true
    };
}

<h1>Daily Updates</h1>

<partial name="~/Components/_DataTable.cshtml" model="dataTable" />