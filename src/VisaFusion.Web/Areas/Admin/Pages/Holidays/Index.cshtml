@page
@model VisaFusion.Web.Areas.Admin.Pages.Holidays.IndexModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Holidays & Weekly Off";
    ViewData["UseSidebar"] = true;

    var holidayForm = new FormCardModel
    {
        Id = "holiday-create-form",
        Title = "Record an embassy holiday",
        CardClass = "shadow-sm mb-4",
        Form = new FormCardForm
        {
            Id = "holiday-create-form",
            Method = "post",
            Action = "?handler=CreateHoliday",
            AntiForgeryToken = Html.AntiForgeryToken()
        },
        Sections = new List<FormCardSection>
        {
            new()
            {
                Fields = new List<FormField>
                {
                    new() { Name = "embassyId", Label = "Embassy", Type = FormFieldType.Select, Value = string.Empty, Required = true,
                        Options = Model.Embassies.Select(e => new FormFieldOption { Value = e.Id.ToString(), Text = e.Description }).ToList() },
                    new() { Name = "holidayDate", Label = "Holiday date", Type = FormFieldType.Date, Value = string.Empty, Required = true },
                    new() { Name = "description", Label = "Reason (optional)", Type = FormFieldType.Text, Value = string.Empty }
                }
            }
        },
        FooterActions = new List<FormCardAction>
        {
            new() { Title = "Record holiday", Type = FormCardActionType.Submit, CssClass = "btn-primary" }
        }
    };

    var weeklyOffForm = new FormCardModel
    {
        Id = "weeklyoff-create-form",
        Title = "Record a weekly-off day",
        CardClass = "shadow-sm mb-4",
        Form = new FormCardForm
        {
            Id = "weeklyoff-create-form",
            Method = "post",
            Action = "?handler=CreateWeeklyOff",
            AntiForgeryToken = Html.AntiForgeryToken()
        },
        Sections = new List<FormCardSection>
        {
            new()
            {
                Fields = new List<FormField>
                {
                    new() { Name = "embassyId", Label = "Embassy", Type = FormFieldType.Select, Value = string.Empty, Required = true,
                        Options = Model.Embassies.Select(e => new FormFieldOption { Value = e.Id.ToString(), Text = e.Description }).ToList() },
                    new() { Name = "weekday", Label = "Weekday", Type = FormFieldType.Select, Value = string.Empty, Required = true,
                        Options = new List<FormFieldOption>
                        {
                            new() { Value = "1", Text = "Sunday" },
                            new() { Value = "2", Text = "Monday" },
                            new() { Value = "3", Text = "Tuesday" },
                            new() { Value = "4", Text = "Wednesday" },
                            new() { Value = "5", Text = "Thursday" },
                            new() { Value = "6", Text = "Friday" },
                            new() { Value = "7", Text = "Saturday" }
                        } },
                    new() { Name = "description", Label = "Reason (optional)", Type = FormFieldType.Text, Value = string.Empty }
                }
            }
        },
        FooterActions = new List<FormCardAction>
        {
            new() { Title = "Record weekly-off", Type = FormCardActionType.Submit, CssClass = "btn-primary" }
        }
    };

    var holidaysTable = new DataTableModel
    {
        Id = "holidays-table",
        AriaLabel = "Embassy holidays",
        Columns = new List<DataTableColumn>
        {
            new() { Key = "CountryId", Title = "Embassy", Width = "auto" },
            new() { Key = "HolidayDate", Title = "Date", Width = "140px",
                Formatter = (v) => v is DateTime dt ? dt.ToString("dd-MMM-yyyy") : (v?.ToString() ?? "—") },
            new() { Key = "Description", Title = "Reason", Width = "auto" }
        },
        Rows = Model.Holidays.Select(h => new Dictionary<string, object>
        {
            ["CountryId"] = h.CountryId ?? (object)DBNull.Value,
            ["HolidayDate"] = h.HolidayDate ?? (object)DBNull.Value,
            ["Description"] = h.Description ?? "—",
            ["Id"] = h.Id
        }).ToList(),
        ShowPagination = false,
        EmptyMessage = "No holidays recorded.",
        Responsive = true,
        RowActions = new List<DataTableAction>
        {
            new() { Name = "Delete", Title = "Delete", OnClick = "openHolidayDeleteModal", CssClass = "text-danger" }
        }
    };

    var weeklyOffsTable = new DataTableModel
    {
        Id = "weeklyoffs-table",
        AriaLabel = "Weekly-off days",
        Columns = new List<DataTableColumn>
        {
            new() { Key = "EmbassyId", Title = "Embassy", Width = "auto" },
            new() { Key = "Weekend", Title = "Weekday", Width = "100px",
                Formatter = (v) => v is int i ? (i switch { 1 => "Sunday", 2 => "Monday", 3 => "Tuesday", 4 => "Wednesday", 5 => "Thursday", 6 => "Friday", 7 => "Saturday", _ => $"Weekday {i}" }) : (v?.ToString() ?? "—") },
            new() { Key = "Description", Title = "Reason", Width = "auto" }
        },
        Rows = Model.WeeklyOffs.Select(w => new Dictionary<string, object>
        {
            ["EmbassyId"] = w.EmbassyId ?? (object)DBNull.Value,
            ["Weekend"] = w.Weekend ?? (object)DBNull.Value,
            ["Description"] = w.Description ?? "—",
            ["Id"] = w.Id
        }).ToList(),
        ShowPagination = false,
        EmptyMessage = "No weekly-off days recorded.",
        Responsive = true,
        RowActions = new List<DataTableAction>
        {
            new() { Name = "Delete", Title = "Delete", OnClick = "openWeeklyOffDeleteModal", CssClass = "text-danger" }
        }
    };

    // ConfirmModal for holiday deletion
    var holidayDeleteModal = new ConfirmModalModel
    {
        Id = "holiday-delete-modal",
        Title = "Delete Holiday",
        Message = "Are you sure you want to delete this holiday?",
        Description = "This action cannot be undone.",
        Icon = "M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646a.5.5 0 0 0-.708 0z",
        IconColor = "text-danger",
        ConfirmText = "Delete",
        CancelText = "Cancel",
        ConfirmCssClass = "btn-danger",
        ConfirmOnClick = "confirmHolidayDelete()"
    };

    // ConfirmModal for weekly-off deletion
    var weeklyOffDeleteModal = new ConfirmModalModel
    {
        Id = "weeklyoff-delete-modal",
        Title = "Delete Weekly-Off Day",
        Message = "Are you sure you want to delete this weekly-off day?",
        Description = "This action cannot be undone.",
        Icon = "M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646a.5.5 0 0 0-.708 0z",
        IconColor = "text-danger",
        ConfirmText = "Delete",
        CancelText = "Cancel",
        ConfirmCssClass = "btn-danger",
        ConfirmOnClick = "confirmWeeklyOffDelete()"
    };
}

@if (!string.IsNullOrWhiteSpace(Model.OutcomeMessage))
{
    <div class="alert alert-success" role="status">@Model.OutcomeMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.OutcomeError))
{
    <div class="alert alert-danger" role="alert">@Model.OutcomeError</div>
}

<partial name="~/Components/_FormCard.cshtml" model="holidayForm" />

<div class="card shadow-sm mb-4">
    <div class="card-header"><h2 class="h5 card-title mb-0">Embassy holidays</h2></div>
    <partial name="~/Components/_DataTable.cshtml" model="holidaysTable" />
</div>

<partial name="~/Components/_FormCard.cshtml" model="weeklyOffForm" />

<div class="card shadow-sm mb-4">
    <div class="card-header"><h2 class="h5 card-title mb-0">Weekly-off days</h2></div>
    <partial name="~/Components/_DataTable.cshtml" model="weeklyOffsTable" />
</div>

@* ConfirmModals for delete actions (SPEC-0009 T051/T052) *@
<partial name="~/Components/_ConfirmModal.cshtml" model="holidayDeleteModal" />
<partial name="~/Components/_ConfirmModal.cshtml" model="weeklyOffDeleteModal" />

<script>
(function() {
    // Store the ID of the item to delete
    let pendingDeleteId = null;
    let pendingDeleteType = null; // 'holiday' or 'weeklyoff'

    // Open holiday delete modal
    window.openHolidayDeleteModal = function(event, id) {
        event.preventDefault();
        event.stopPropagation();
        pendingDeleteId = id;
        pendingDeleteType = 'holiday';
        const modal = new coreui.Modal(document.getElementById('holiday-delete-modal'));
        modal.show();
    };

    // Open weekly-off delete modal
    window.openWeeklyOffDeleteModal = function(event, id) {
        event.preventDefault();
        event.stopPropagation();
        pendingDeleteId = id;
        pendingDeleteType = 'weeklyoff';
        const modal = new coreui.Modal(document.getElementById('weeklyoff-delete-modal'));
        modal.show();
    };

    // Confirm holiday deletion — POST with anti-forgery token
    window.confirmHolidayDelete = function() {
        if (pendingDeleteId) {
            var form = document.createElement('form');
            form.method = 'post';
            form.action = '?handler=DeleteHoliday&id=' + pendingDeleteId;
            // Copy anti-forgery token from the existing form on the page
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                var hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = '__RequestVerificationToken';
                hidden.value = token.value;
                form.appendChild(hidden);
            }
            document.body.appendChild(form);
            form.submit();
        }
    };

    // Confirm weekly-off deletion — POST with anti-forgery token
    window.confirmWeeklyOffDelete = function() {
        if (pendingDeleteId) {
            var form = document.createElement('form');
            form.method = 'post';
            form.action = '?handler=DeleteWeeklyOff&id=' + pendingDeleteId;
            // Copy anti-forgery token from the existing form on the page
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                var hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = '__RequestVerificationToken';
                hidden.value = token.value;
                form.appendChild(hidden);
            }
            document.body.appendChild(form);
            form.submit();
        }
    };
})();
</script>