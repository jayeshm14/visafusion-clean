@page
@model VisaFusion.Web.Areas.Admin.Pages.Holidays.IndexModel
@{
    ViewData["Title"] = "Holidays & Weekly Off";
    ViewData["UseSidebar"] = true;
}

@if (!string.IsNullOrWhiteSpace(Model.OutcomeMessage))
{
    <div class="alert alert-success" role="status">@Model.OutcomeMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.OutcomeError))
{
    <div class="alert alert-danger" role="alert">@Model.OutcomeError</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header"><h2 class="h5 card-title mb-0">Record an embassy holiday</h2></div>
    <div class="card-body">
        <form method="post" asp-page-handler="CreateHoliday">
            <div class="mb-3">
                <label class="form-label" for="holiday-embassyId">Embassy</label>
                <select id="holiday-embassyId" name="embassyId" required class="form-select">
                    @foreach (var embassy in Model.Embassies)
                    {
                        <option value="@embassy.Id">@embassy.Description</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="holiday-date">Holiday date</label>
                <input type="date" id="holiday-date" name="holidayDate" required class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="holiday-description">Reason (optional)</label>
                <input type="text" id="holiday-description" name="description" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Record holiday</button>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header"><h2 class="h5 card-title mb-0">Embassy holidays</h2></div>
    @if (Model.Holidays.Count == 0)
    {
        <div class="card-body">
            <p class="mb-0">No holidays recorded.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Embassy</th>
                        <th scope="col">Date</th>
                        <th scope="col">Reason</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var holiday in Model.Holidays)
                    {
                        <tr>
                            <td>@holiday.CountryId</td>
                            <td>@(holiday.HolidayDate?.ToString("dd-MMM-yyyy") ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(holiday.Description) ? "—" : holiday.Description)</td>
                            <td>
                                <form method="post" asp-page-handler="DeleteHoliday" class="d-inline">
                                    <input type="hidden" name="id" value="@holiday.Id" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header"><h2 class="h5 card-title mb-0">Record a weekly-off day</h2></div>
    <div class="card-body">
        <form method="post" asp-page-handler="CreateWeeklyOff">
            <div class="mb-3">
                <label class="form-label" for="wo-embassyId">Embassy</label>
                <select id="wo-embassyId" name="embassyId" required class="form-select">
                    @foreach (var embassy in Model.Embassies)
                    {
                        <option value="@embassy.Id">@embassy.Description</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="wo-weekday">Weekday</label>
                <select id="wo-weekday" name="weekday" required class="form-select">
                    <option value="1">Sunday</option>
                    <option value="2">Monday</option>
                    <option value="3">Tuesday</option>
                    <option value="4">Wednesday</option>
                    <option value="5">Thursday</option>
                    <option value="6">Friday</option>
                    <option value="7">Saturday</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="wo-description">Reason (optional)</label>
                <input type="text" id="wo-description" name="description" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Record weekly-off</button>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header"><h2 class="h5 card-title mb-0">Weekly-off days</h2></div>
    @if (Model.WeeklyOffs.Count == 0)
    {
        <div class="card-body">
            <p class="mb-0">No weekly-off days recorded.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Embassy</th>
                        <th scope="col">Weekday</th>
                        <th scope="col">Reason</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var weeklyOff in Model.WeeklyOffs)
                    {
                        <tr>
                            <td>@weeklyOff.EmbassyId</td>
                            <td>@weeklyOff.Weekend</td>
                            <td>@(string.IsNullOrWhiteSpace(weeklyOff.Description) ? "—" : weeklyOff.Description)</td>
                            <td>
                                <form method="post" asp-page-handler="DeleteWeeklyOff" class="d-inline">
                                    <input type="hidden" name="id" value="@weeklyOff.Id" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>