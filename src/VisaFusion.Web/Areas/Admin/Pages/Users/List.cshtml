@page
@model VisaFusion.Web.Areas.Admin.Pages.Users.ListModel
@{
    ViewData["Title"] = "Users";
    ViewData["UseSidebar"] = true;
}

@if (!string.IsNullOrWhiteSpace(Model.OutcomeMessage))
{
    <div class="alert alert-success" role="status">@Model.OutcomeMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.OutcomeError))
{
    <div class="alert alert-danger" role="alert">@Model.OutcomeError</div>
}

<p>
    <a class="btn btn-primary" href="/Admin/Users/Create">New user</a>
</p>

<div class="card shadow-sm">
    @if (Model.Users.Count == 0)
    {
        <div class="card-body">
            <p class="mb-0">No users found.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Login</th>
                        <th scope="col">Email</th>
                        <th scope="col">Roles</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@(string.IsNullOrWhiteSpace(user.Email) ? "—" : user.Email)</td>
                            <td>@string.Join(", ", user.Roles)</td>
                            <td>
                                @if (user.Active)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">Deactivated</span>
                                }
                            </td>
                            <td>
                                @if (user.Active)
                                {
                                    <form method="post" asp-page-handler="Deactivate" class="d-inline">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Deactivate</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>