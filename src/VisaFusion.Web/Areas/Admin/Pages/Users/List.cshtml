@page
@model VisaFusion.Web.Areas.Admin.Pages.Users.ListModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Users";
    ViewData["UseSidebar"] = true;

    var dataTable = new DataTableModel
    {
        Id = "users-table",
        AriaLabel = "User list",
        Columns = new List<DataTableColumn>
        {
            new() { Key = "UserName", Title = "Login", Width = "auto" },
            new() { Key = "Email", Title = "Email", Width = "auto" },
            new() { Key = "Roles", Title = "Roles", Width = "auto",
                Formatter = (v) => v is System.Collections.Generic.IReadOnlyList<string> roles ? string.Join(", ", roles) : v?.ToString() ?? "—" },
            new() { Key = "Active", Title = "Status", Width = "120px",
                Template = (v, row) =>
                {
                    var active = row.ContainsKey("Active") && row["Active"] is bool b && b;
                    if (active)
                        return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"badge text-bg-success\">Active</span>");
                    return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"badge text-bg-danger\">Deactivated</span>");
                } }
        },
        Rows = Model.Users.Select(u => new Dictionary<string, object>
        {
            ["UserName"] = u.UserName,
            ["Email"] = u.Email ?? "—",
            ["Roles"] = u.Roles,
            ["Active"] = u.Active
        }).ToList(),
        ShowPagination = false,
        EmptyMessage = "No users found.",
        Responsive = true,
        RowActions = new List<DataTableAction>
        {
            new() { Name = "Deactivate", Title = "Deactivate", UrlTemplate = "/Admin/Users/List?handler=Deactivate&id={0}", CssClass = "text-danger", Method = "post" }
        }
    };
}

@if (!string.IsNullOrWhiteSpace(Model.OutcomeMessage))
{
    <div class="alert alert-success" role="status">@Model.OutcomeMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.OutcomeError))
{
    <div class="alert alert-danger" role="alert">@Model.OutcomeError</div>
}

<p>
    <a class="btn btn-primary" href="/Admin/Users/Create">New user</a>
</p>

<partial name="~/Components/_DataTable.cshtml" model="dataTable" />