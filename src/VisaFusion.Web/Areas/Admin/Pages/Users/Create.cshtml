@page
@model VisaFusion.Web.Areas.Admin.Pages.Users.CreateModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "New user";
    ViewData["UseSidebar"] = true;

    var formCard = new FormCardModel
    {
        Id = "user-create-form",
        Title = "New user",
        CardClass = "shadow-sm",
        Form = new FormCardForm
        {
            Id = "user-create-form",
            Method = "post",
            AntiForgeryToken = Html.AntiForgeryToken()
        },
        Sections = new List<FormCardSection>
        {
            new()
            {
                Title = "Account",
                Fields = new List<FormField>
                {
                    new() { Name = "Username", Label = "Login username", Type = FormFieldType.Text, Value = Model.Username ?? string.Empty, Required = true },
                    new() { Name = "Password", Label = "Initial password", Type = FormFieldType.Password, Value = string.Empty, Required = true },
                    new() { Name = "Email", Label = "Email", Type = FormFieldType.Email, Value = Model.Email ?? string.Empty },
                    new() { Name = "Role", Label = "Role", Type = FormFieldType.Select, Value = Model.Role ?? string.Empty, Required = true,
                        Options = Model.AllowedRoles.Select(r => new FormFieldOption { Value = r, Text = r }).ToList() },
                    new() { Name = "AgentId", Label = "Agent ID", Type = FormFieldType.Number, Value = Model.AgentId?.ToString() ?? string.Empty,
                        HelpText = "Required when the role is agt." }
                }
            }
        },
        FooterActions = new List<FormCardAction>
        {
            new() { Title = "Create user", Type = FormCardActionType.Submit, CssClass = "btn-primary" },
            new() { Title = "Cancel", Type = FormCardActionType.Link, Url = "/Admin/Users/List", CssClass = "btn-outline-secondary" }
        }
    };
}

<partial name="~/Components/_FormCard.cshtml" model="formCard" />