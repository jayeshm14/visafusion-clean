@page
@model VisaFusion.Web.Areas.Admin.Pages.ContentUpdate.IndexModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Daily Updates";
    ViewData["UseSidebar"] = true;

    var createForm = new FormCardModel
    {
        Id = "content-create-form",
        Title = "Record a daily update",
        CardClass = "shadow-sm mb-4",
        Form = new FormCardForm
        {
            Id = "content-create-form",
            Method = "post",
            Action = "?handler=Create",
            AntiForgeryToken = Html.AntiForgeryToken()
        },
        Sections = new List<FormCardSection>
        {
            new()
            {
                Fields = new List<FormField>
                {
                    new() { Name = "entrydate", Label = "Date", Type = FormFieldType.Date, Value = DateTime.Today.ToString("yyyy-MM-dd"), Required = true },
                    new() { Name = "description", Label = "Message", Type = FormFieldType.TextArea, Value = string.Empty, Required = true, Rows = 5, MaxLength = 8000 }
                }
            }
        },
        FooterActions = new List<FormCardAction>
        {
            new() { Title = "Record", Type = FormCardActionType.Submit, CssClass = "btn-primary" }
        }
    };

    var entriesTable = new DataTableModel
    {
        Id = "content-table",
        AriaLabel = "Daily updates",
        Columns = new List<DataTableColumn>
        {
            new() { Key = "Entrydate", Title = "Date", Width = "140px",
                Formatter = (v) => v is DateTime dt ? dt.ToString("dd-MMM-yyyy") : (v?.ToString() ?? "—") },
            new() { Key = "Description", Title = "Message", Width = "auto" }
        },
        Rows = Model.Entries.Select(e => new Dictionary<string, object>
        {
            ["Entrydate"] = e.Entrydate ?? (object)DBNull.Value,
            ["Description"] = e.Description ?? string.Empty,
            ["Id"] = e.Id
        }).ToList(),
        ShowPagination = false,
        EmptyMessage = "No daily updates recorded.",
        Responsive = true,
        RowActions = new List<DataTableAction>
        {
            new() { Name = "Edit", Title = "Edit", UrlTemplate = "?handler=Edit&id={0}", CssClass = "", Method = "post" },
            new() { Name = "Delete", Title = "Delete", UrlTemplate = "?handler=Delete&id={0}", CssClass = "text-danger", Method = "post" }
        }
    };
}

@if (!string.IsNullOrWhiteSpace(Model.OutcomeMessage))
{
    <div class="alert alert-success" role="status">@Model.OutcomeMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.OutcomeError))
{
    <div class="alert alert-danger" role="alert">@Model.OutcomeError</div>
}

<partial name="~/Components/_FormCard.cshtml" model="createForm" />

<div class="card shadow-sm mb-4">
    <div class="card-header"><h2 class="h5 card-title mb-0">Daily updates</h2></div>
    <partial name="~/Components/_DataTable.cshtml" model="entriesTable" />
</div>