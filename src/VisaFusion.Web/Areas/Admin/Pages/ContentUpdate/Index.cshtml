@page
@model VisaFusion.Web.Areas.Admin.Pages.ContentUpdate.IndexModel
@{
    ViewData["Title"] = "Daily Updates";
    ViewData["UseSidebar"] = true;
}

@if (!string.IsNullOrWhiteSpace(Model.OutcomeMessage))
{
    <div class="alert alert-success" role="status">@Model.OutcomeMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.OutcomeError))
{
    <div class="alert alert-danger" role="alert">@Model.OutcomeError</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header"><h2 class="h5 card-title mb-0">Record a daily update</h2></div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create">
            <div class="mb-3">
                <label class="form-label" for="entrydate">Date</label>
                <input type="date" id="entrydate" name="entrydate" required class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="description">Message</label>
                <textarea id="description" name="description" rows="5" required class="form-control" maxlength="8000"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Record</button>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    @if (Model.Entries.Count == 0)
    {
        <div class="card-body">
            <p class="mb-0">No daily updates recorded.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Message</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td>@(entry.Entrydate?.ToString("dd-MMM-yyyy") ?? "—")</td>
                            <td>@entry.Description</td>
                            <td>
                                <details>
                                    <summary class="btn btn-outline-secondary btn-sm">Edit</summary>
                                    <form method="post" asp-page-handler="Edit" class="mt-2">
                                        <input type="hidden" name="id" value="@entry.Id" />
                                        <div class="mb-3">
                                            <label class="form-label" for="entrydate-@entry.Id">Date</label>
                                            <input type="date" id="entrydate-@entry.Id" name="entrydate" required class="form-control"
                                                   value="@(entry.Entrydate?.ToString("yyyy-MM-dd"))" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label" for="description-@entry.Id">Message</label>
                                            <textarea id="description-@entry.Id" name="description" rows="3" required class="form-control" maxlength="8000">@entry.Description</textarea>
                                        </div>
                                        <button type="submit" class="btn btn-primary">Save</button>
                                    </form>
                                </details>
                                <form method="post" asp-page-handler="Delete" class="d-inline">
                                    <input type="hidden" name="id" value="@entry.Id" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>