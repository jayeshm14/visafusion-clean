@page
@model VisaFusion.Web.Areas.Admin.Pages.Agents.EditModel
@{
    ViewData["Title"] = $"Edit agent {Model.Id}";
    ViewData["UseSidebar"] = true;
}

@if (Model.IsNotFound)
{
    <div class="alert alert-danger" role="alert">
        Agent @Model.Id was not found.
    </div>
    <a class="btn btn-outline-secondary" href="/Admin/Agents/List">Back to agents</a>
}
else
{
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="card shadow-sm mb-4">
            <div class="card-header"><h2 class="h5 card-title mb-0">Company</h2></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" asp-for="Companyname">Company name</label>
                    <input class="form-control" asp-for="Companyname" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Description">Description</label>
                    <input class="form-control" asp-for="Description" />
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header"><h2 class="h5 card-title mb-0">Address</h2></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" asp-for="Street1">Street 1</label>
                    <input class="form-control" asp-for="Street1" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Street2">Street 2</label>
                    <input class="form-control" asp-for="Street2" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Area">Area</label>
                    <input class="form-control" asp-for="Area" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="City">City</label>
                    <input class="form-control" asp-for="City" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Pincode">PIN code</label>
                    <input class="form-control" asp-for="Pincode" />
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header"><h2 class="h5 card-title mb-0">Contact</h2></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" asp-for="Phoneno">Phone</label>
                    <input class="form-control" asp-for="Phoneno" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Faxno">Fax</label>
                    <input class="form-control" asp-for="Faxno" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Emailid">Email</label>
                    <input class="form-control" asp-for="Emailid" type="email" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Smsno">SMS number</label>
                    <input class="form-control" asp-for="Smsno" />
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header"><h2 class="h5 card-title mb-0">People</h2></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" asp-for="Directorname">Director</label>
                    <input class="form-control" asp-for="Directorname" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="DirectorPH">Director phone</label>
                    <input class="form-control" asp-for="DirectorPH" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="AcMgrPH">Accounts manager phone</label>
                    <input class="form-control" asp-for="AcMgrPH" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="VisaInchargeName">Visa in-charge</label>
                    <input class="form-control" asp-for="VisaInchargeName" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="VisaInchargePH">Visa in-charge phone</label>
                    <input class="form-control" asp-for="VisaInchargePH" />
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header"><h2 class="h5 card-title mb-0">Financial</h2></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" asp-for="Acno">Account number</label>
                    <input class="form-control" asp-for="Acno" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Payment">Payment</label>
                    <input class="form-control" asp-for="Payment" />
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header"><h2 class="h5 card-title mb-0">Memberships</h2></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" asp-for="TAAI">TAAI</label>
                    <input class="form-control" asp-for="TAAI" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="TAFI">TAFI</label>
                    <input class="form-control" asp-for="TAFI" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Membership">Membership</label>
                    <input class="form-control" asp-for="Membership" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="IATA">IATA</label>
                    <input class="form-control" asp-for="IATA" />
                </div>
            </div>
        </div>

        <p>
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-outline-secondary" href="/Admin/Agents/Detail?id=@Model.Id">Cancel</a>
        </p>
    </form>
}