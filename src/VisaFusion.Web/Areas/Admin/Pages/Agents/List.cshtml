@page
@model VisaFusion.Web.Areas.Admin.Pages.Agents.ListModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Agents";
    ViewData["UseSidebar"] = true;

    var dataTable = new DataTableModel
    {
        Id = "agents-table",
        AriaLabel = "Agent list",
        Columns = new List<DataTableColumn>
        {
            new() { Key = "Id", Title = "ID", Width = "80px" },
            new() { Key = "Companyname", Title = "Company", Width = "auto" },
            new() { Key = "City", Title = "City", Width = "auto" },
            new() { Key = "Phoneno", Title = "Phone", Width = "auto" },
            new() { Key = "Active", Title = "Status", Width = "120px",
                Template = (v, row) =>
                {
                    var active = row.ContainsKey("Active") ? row["Active"]?.ToString() : null;
                    if (active == "Y")
                        return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"badge text-bg-success\">Active</span>");
                    return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"badge text-bg-danger\">Deactivated</span>");
                } }
        },
        Rows = Model.Result.Items.Select(a => new Dictionary<string, object>
        {
            ["Id"] = a.Id,
            ["Companyname"] = a.Companyname ?? "—",
            ["City"] = a.City ?? "—",
            ["Phoneno"] = a.Phoneno ?? "—",
            ["Active"] = a.Active ?? "N"
        }).ToList(),
        ShowPagination = true,
        PageSize = 50,
        CurrentPage = Model.PageNumber,
        TotalRows = Model.Result.Total,
        Sortable = true,
        Searchable = true,
        EmptyMessage = string.IsNullOrWhiteSpace(Model.Q)
            ? "No agents found."
            : "No agents found. Try a different search term.",
        Responsive = true,
        RowActions = new List<DataTableAction>
        {
            new() { Name = "View", Title = "View", UrlTemplate = "/Admin/Agents/Detail?id={0}", CssClass = "" },
            new() { Name = "Edit", Title = "Edit", UrlTemplate = "/Admin/Agents/Edit?id={0}", CssClass = "" }
        },
        PageUrlTemplate = string.IsNullOrWhiteSpace(Model.Q)
            ? "/Admin/Agents/List?page={0}"
            : $"/Admin/Agents/List?page={{0}}&q={System.Net.WebUtility.UrlEncode(Model.Q)}"
    };
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-auto" style="max-width: 28rem;">
                <label class="form-label" asp-for="Q">Search by company name</label>
                <input class="form-control" asp-for="Q" placeholder="e.g. Acme Travels" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Search</button>
                <a class="btn btn-outline-secondary" href="/Admin/Agents/List">Clear</a>
            </div>
        </form>
    </div>
</div>

<partial name="~/Components/_DataTable.cshtml" model="dataTable" />