@page
@model VisaFusion.Web.Areas.Admin.Pages.Agents.ListModel
@{
    ViewData["Title"] = "Agents";
    ViewData["UseSidebar"] = true;
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-auto" style="max-width: 28rem;">
                <label class="form-label" asp-for="Q">Search by company name</label>
                <input class="form-control" asp-for="Q" placeholder="e.g. Acme Travels" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Search</button>
                <a class="btn btn-outline-secondary" href="/Admin/Agents/List">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    @if (Model.Result.Items.Count == 0)
    {
        <div class="card-body">
            <p class="mb-0">No agents found.@(string.IsNullOrWhiteSpace(Model.Q) ? "" : " Try a different search term.")</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Company</th>
                        <th scope="col">City</th>
                        <th scope="col">Phone</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var agent in Model.Result.Items)
                    {
                        <tr>
                            <td>@agent.Id</td>
                            <td>@(string.IsNullOrWhiteSpace(agent.Companyname) ? "—" : agent.Companyname)</td>
                            <td>@(string.IsNullOrWhiteSpace(agent.City) ? "—" : agent.City)</td>
                            <td>@(string.IsNullOrWhiteSpace(agent.Phoneno) ? "—" : agent.Phoneno)</td>
                            <td>
                                @if (agent.Active == "Y")
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">Deactivated</span>
                                }
                            </td>
                            <td>
                                <a href="/Admin/Agents/Detail?id=@agent.Id">View</a>
                                &nbsp;|&nbsp;
                                <a href="/Admin/Agents/Edit?id=@agent.Id">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.Result.Total > 0)
{
    var totalPages = (int)Math.Ceiling(Model.Result.Total / 50.0);
    <nav aria-label="Agent list pages" class="mt-3">
        <p class="mb-1">
            Page @Model.PageNumber of @totalPages (@Model.Result.Total agents)
        </p>
        <p class="mb-0">
            @if (Model.PageNumber > 1)
            {
                <a class="btn btn-outline-secondary btn-sm" href="/Admin/Agents/List?page=@(Model.PageNumber - 1)&q=@Uri.EscapeDataString(Model.Q ?? string.Empty)">Previous</a>
            }
            @if (Model.PageNumber < totalPages)
            {
                <a class="btn btn-outline-secondary btn-sm" href="/Admin/Agents/List?page=@(Model.PageNumber + 1)&q=@Uri.EscapeDataString(Model.Q ?? string.Empty)">Next</a>
            }
        </p>
    </nav>
}