@page
@model VisaFusion.Web.Areas.Admin.Pages.Agents.DetailModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Agent detail";
    ViewData["UseSidebar"] = true;
}

@if (Model.IsNotFound)
{
    <div class="alert alert-danger" role="alert">
        Agent @Model.Id was not found.
    </div>
    <a class="btn btn-outline-secondary" href="/Admin/Agents/List">Back to agents</a>
}
else
{
    var infoPage = new InfoPageModel
    {
        Id = "agent-detail",
        Title = "Agent detail",
        CardClass = "shadow-sm",
        Cards = new List<InfoPageCard>
        {
            new()
            {
                Title = "Status",
                Content = Model.Agent!.Active == "Y" ? "Active" : "Deactivated",
                CardClass = Model.Agent!.Active == "Y" ? "border-success" : "border-danger",
                Actions = new List<InfoPageAction>
                {
                    new()
                    {
                        Title = Model.Agent!.Active == "Y" ? "Deactivate" : "Reactivate",
                        Url = Model.Agent!.Active == "Y" ? $"/Admin/Agents/Detail?id={Model.Agent.Id}&handler=Deactivate" : $"/Admin/Agents/Detail?id={Model.Agent.Id}&handler=Reactivate",
                        CssClass = Model.Agent!.Active == "Y" ? "btn-danger" : "btn-primary",
                        Method = "post"
                    }
                }
            },
            new()
            {
                Title = "ID",
                Content = Model.Agent!.Id.ToString()
            },
            new()
            {
                Title = "Company name",
                Content = Model.Agent!.Companyname ?? "—"
            },
            new()
            {
                Title = "Description",
                Content = Model.Agent!.Description ?? "—"
            },
            new()
            {
                Title = "Address",
                Content = $"{Model.Agent!.Street1 ?? "—"}{(string.IsNullOrWhiteSpace(Model.Agent!.Street2) ? "" : ", " + Model.Agent!.Street2)}{(string.IsNullOrWhiteSpace(Model.Agent!.Area) ? "" : ", " + Model.Agent!.Area)}{(string.IsNullOrWhiteSpace(Model.Agent!.City) ? "" : ", " + Model.Agent!.City)}{(string.IsNullOrWhiteSpace(Model.Agent!.Pincode) ? "" : " — " + Model.Agent!.Pincode)}"
            },
            new()
            {
                Title = "Phone",
                Content = Model.Agent!.Phoneno ?? "—"
            },
            new()
            {
                Title = "Fax",
                Content = Model.Agent!.Faxno ?? "—"
            },
            new()
            {
                Title = "Email",
                Content = Model.Agent!.Emailid ?? "—"
            },
            new()
            {
                Title = "SMS number",
                Content = Model.Agent!.Smsno ?? "—"
            },
            new()
            {
                Title = "Director",
                Content = Model.Agent!.Directorname ?? "—"
            },
            new()
            {
                Title = "Director phone",
                Content = Model.Agent!.DirectorPH ?? "—"
            },
            new()
            {
                Title = "Accounts manager phone",
                Content = Model.Agent!.AcMgrPH ?? "—"
            },
            new()
            {
                Title = "Visa in-charge",
                Content = Model.Agent!.VisaInchargeName ?? "—"
            },
            new()
            {
                Title = "Visa in-charge phone",
                Content = Model.Agent!.VisaInchargePH ?? "—"
            },
            new()
            {
                Title = "Account number",
                Content = Model.Agent!.Acno ?? "—"
            },
            new()
            {
                Title = "Payment",
                Content = Model.Agent!.Payment ?? "—"
            },
            new()
            {
                Title = "TAAI",
                Content = Model.Agent!.TAAI ?? "—"
            },
            new()
            {
                Title = "TAFI",
                Content = Model.Agent!.TAFI ?? "—"
            },
            new()
            {
                Title = "Membership",
                Content = Model.Agent!.Membership ?? "—"
            },
            new()
            {
                Title = "IATA",
                Content = Model.Agent!.IATA ?? "—"
            },
            new()
            {
                Title = "Created",
                Content = $"{Model.Agent!.Creationdate?.ToString("yyyy-MM-dd") ?? "—"} by {Model.Agent!.Enteredby ?? "—"}"
            }
        },
        Actions = new List<InfoPageAction>
        {
            new() { Title = "Back to agents", Url = "/Admin/Agents/List", CssClass = "btn-outline-secondary" },
            new() { Title = "Edit", Url = $"/Admin/Agents/Edit?id={Model.Agent!.Id}", CssClass = "btn-primary" }
        }
    };

    @if (Model.OutcomeMessage is not null)
    {
        <div class="alert alert-success" role="alert">@Model.OutcomeMessage</div>
    }

    <partial name="~/Components/_InfoPage.cshtml" model="infoPage" />
}