@page
@model VisaFusion.Web.Areas.Agent.Pages.StatusesModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "Passenger statuses";
    ViewData["UseSidebar"] = true;

    var dataTable = new DataTableModel
    {
        Id = "statuses-table",
        AriaLabel = "Agent passenger statuses",
        Columns = new List<DataTableColumn>
        {
            new() { Key = "Refno", Title = "Ref no.", Width = "120px" },
            new() { Key = "Paxname", Title = "Passenger", Width = "auto" },
            new() { Key = "StatusDescription", Title = "Status", Width = "auto" },
            new() { Key = "Updated", Title = "Updated", Width = "140px",
                Formatter = (v) => v is DateTime dt ? dt.ToString("yyyy-MM-dd") : (v?.ToString() ?? "—") }
        },
        Rows = Model.Result?.Items.Select(s => new Dictionary<string, object>
        {
            ["Refno"] = s.Refno,
            ["Paxname"] = s.Paxname ?? "—",
            ["StatusDescription"] = s.StatusDescription ?? "—",
            ["Updated"] = s.Updated ?? (object)DBNull.Value
        }).ToList() ?? new List<Dictionary<string, object>>(),
        ShowPagination = false,
        EmptyMessage = string.IsNullOrWhiteSpace(Model.Q)
            ? "No passenger statuses found."
            : "No passenger statuses found. Try a different search term.",
        Responsive = true
    };
}

@if (Model.HasNoLinkedAgent)
{
    <div class="alert alert-danger" role="alert">
        This account has no linked agent (CHK026). Contact the office to have
        an agent bound to this login before using the portal.
    </div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-auto" style="max-width: 28rem;">
                    <label class="form-label" asp-for="Q">Search by passenger name or ref no.</label>
                    <input class="form-control" asp-for="Q" placeholder="e.g. passenger name or 12345" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <a class="btn btn-outline-secondary" href="/Agent/Statuses">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <partial name="~/Components/_DataTable.cshtml" model="dataTable" />
}