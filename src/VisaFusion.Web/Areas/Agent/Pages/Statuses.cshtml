@page
@model VisaFusion.Web.Areas.Agent.Pages.StatusesModel
@{
    ViewData["Title"] = "Passenger statuses";
    ViewData["UseSidebar"] = true;
}

@if (Model.HasNoLinkedAgent)
{
    <div class="alert alert-danger" role="alert">
        This account has no linked agent (CHK026). Contact the office to have
        an agent bound to this login before using the portal.
    </div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-auto" style="max-width: 28rem;">
                    <label class="form-label" asp-for="Q">Search by passenger name or ref no.</label>
                    <input class="form-control" asp-for="Q" placeholder="e.g. passenger name or 12345" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <a class="btn btn-outline-secondary" href="/Agent/Statuses">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        @if (Model.Result!.Items.Count == 0)
        {
            <div class="card-body">
                <p class="mb-0">No passenger statuses found.@(string.IsNullOrWhiteSpace(Model.Q) ? "" : " Try a different search term.")</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Ref no.</th>
                            <th scope="col">Passenger</th>
                            <th scope="col">Status</th>
                            <th scope="col">Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var status in Model.Result.Items)
                        {
                            <tr>
                                <td>@status.Refno</td>
                                <td>@(string.IsNullOrWhiteSpace(status.Paxname) ? "—" : status.Paxname)</td>
                                <td>@(string.IsNullOrWhiteSpace(status.StatusDescription) ? "—" : status.StatusDescription)</td>
                                <td>@(status.Updated?.ToString("yyyy-MM-dd") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}