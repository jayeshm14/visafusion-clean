@page
@model VisaFusion.Web.Areas.Agent.Pages.StatusesModel
@{
    ViewData["Title"] = "Passenger statuses";
    ViewData["UseSidebar"] = true;
}

@section SidebarNav {
    <a asp-area="Agent" asp-page="/Index">Portal home</a>
    <a asp-area="Agent" asp-page="/Entries">My entries</a>
    <a asp-area="Agent" asp-page="/Statuses" aria-current="page">Passenger statuses</a>
    <a asp-area="Agent" asp-page="/Statement">Statement</a>
    <a asp-area="Agent" asp-page="/Account">My account</a>
}

<div class="vf-content">
    <h1>Passenger statuses</h1>

    @if (Model.HasNoLinkedAgent)
    {
        <div class="vf-alert vf-alert-danger" role="alert">
            This account has no linked agent (CHK026). Contact the office to have
            an agent bound to this login before using the portal.
        </div>
    }
    else
    {
        <div class="vf-card">
            <form method="get">
                <div class="vf-form-group" style="max-width: 28rem;">
                    <label class="vf-form-label" asp-for="Q">Search by passenger name or ref no.</label>
                    <input class="vf-form-control" asp-for="Q" placeholder="e.g. passenger name or 12345" />
                </div>
                <button type="submit" class="vf-btn vf-btn-primary">Search</button>
                <a class="vf-btn vf-btn-secondary" href="/Agent/Statuses">Clear</a>
            </form>
        </div>

        <div class="vf-card">
            @if (Model.Result!.Items.Count == 0)
            {
                <p>No passenger statuses found.@(string.IsNullOrWhiteSpace(Model.Q) ? "" : " Try a different search term.")</p>
            }
            else
            {
                <table class="vf-table">
                    <thead>
                        <tr>
                            <th scope="col">Ref no.</th>
                            <th scope="col">Passenger</th>
                            <th scope="col">Status</th>
                            <th scope="col">Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var status in Model.Result.Items)
                        {
                            <tr>
                                <td>@status.Refno</td>
                                <td>@(string.IsNullOrWhiteSpace(status.Paxname) ? "—" : status.Paxname)</td>
                                <td>@(string.IsNullOrWhiteSpace(status.StatusDescription) ? "—" : status.StatusDescription)</td>
                                <td>@(status.Updated?.ToString("yyyy-MM-dd") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>
