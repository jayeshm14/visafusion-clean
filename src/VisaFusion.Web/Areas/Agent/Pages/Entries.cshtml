@page
@model VisaFusion.Web.Areas.Agent.Pages.EntriesModel
@{
    ViewData["Title"] = "My entries";
    ViewData["UseSidebar"] = true;
}

@if (Model.HasNoLinkedAgent)
{
    <div class="alert alert-danger" role="alert">
        This account has no linked agent (CHK026). Contact the office to have
        an agent bound to this login before using the portal.
    </div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-auto" style="max-width: 28rem;">
                    <label class="form-label" asp-for="Q">Search by passenger name or ref no.</label>
                    <input class="form-control" asp-for="Q" placeholder="e.g. passenger name or 12345" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <a class="btn btn-outline-secondary" href="/Agent/Entries">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        @if (Model.Result!.Items.Count == 0)
        {
            <div class="card-body">
                <p class="mb-0">No entries found.@(string.IsNullOrWhiteSpace(Model.Q) ? "" : " Try a different search term.")</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Ref no.</th>
                            <th scope="col">Passenger</th>
                            <th scope="col">Travel date</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Result.Items)
                        {
                            <tr>
                                <td>@entry.Refno</td>
                                <td>@(string.IsNullOrWhiteSpace(entry.Paxname) ? "—" : entry.Paxname)</td>
                                <td>@(entry.Traveldate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(entry.StatusDescription) ? "—" : entry.StatusDescription)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model.Result.Total > 0)
    {
        var totalPages = (int)Math.Ceiling(Model.Result.Total / 50.0);
        <nav aria-label="Entries pages" class="mt-3">
            <p class="mb-1">
                Page @Model.PageNumber of @totalPages (@Model.Result.Total entries)
            </p>
            <p class="mb-0">
                @if (Model.PageNumber > 1)
                {
                    <a class="btn btn-outline-secondary btn-sm" href="/Agent/Entries?page=@(Model.PageNumber - 1)&q=@Uri.EscapeDataString(Model.Q ?? string.Empty)">Previous</a>
                }
                @if (Model.PageNumber < totalPages)
                {
                    <a class="btn btn-outline-secondary btn-sm" href="/Agent/Entries?page=@(Model.PageNumber + 1)&q=@Uri.EscapeDataString(Model.Q ?? string.Empty)">Next</a>
                }
            </p>
        </nav>
    }
}