@page
@model VisaFusion.Web.Areas.Agent.Pages.EntriesModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "My entries";
    ViewData["UseSidebar"] = true;

    var dataTable = new DataTableModel
    {
        Id = "entries-table",
        AriaLabel = "Agent entries",
        Columns = new List<DataTableColumn>
        {
            new() { Key = "Refno", Title = "Ref no.", Width = "120px" },
            new() { Key = "Paxname", Title = "Passenger", Width = "auto" },
            new() { Key = "Traveldate", Title = "Travel date", Width = "140px",
                Formatter = (v) => v is DateTime dt ? dt.ToString("yyyy-MM-dd") : (v?.ToString() ?? "—") },
            new() { Key = "StatusDescription", Title = "Status", Width = "auto" }
        },
        Rows = Model.Result?.Items.Select(e => new Dictionary<string, object>
        {
            ["Refno"] = e.Refno,
            ["Paxname"] = e.Paxname ?? "—",
            ["Traveldate"] = e.Traveldate ?? (object)DBNull.Value,
            ["StatusDescription"] = e.StatusDescription ?? "—"
        }).ToList() ?? new List<Dictionary<string, object>>(),
        ShowPagination = true,
        PageSize = 50,
        CurrentPage = Model.PageNumber,
        TotalRows = Model.Result?.Total ?? 0,
        Sortable = true,
        Searchable = true,
        EmptyMessage = string.IsNullOrWhiteSpace(Model.Q)
            ? "No entries found."
            : "No entries found. Try a different search term.",
        Responsive = true,
        PageUrlTemplate = string.IsNullOrWhiteSpace(Model.Q)
            ? "/Agent/Entries?page={0}"
            : $"/Agent/Entries?page={{0}}&q={System.Net.WebUtility.UrlEncode(Model.Q)}"
    };
}

@if (Model.HasNoLinkedAgent)
{
    <div class="alert alert-danger" role="alert">
        This account has no linked agent (CHK026). Contact the office to have
        an agent bound to this login before using the portal.
    </div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-auto" style="max-width: 28rem;">
                    <label class="form-label" asp-for="Q">Search by passenger name or ref no.</label>
                    <input class="form-control" asp-for="Q" placeholder="e.g. passenger name or 12345" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <a class="btn btn-outline-secondary" href="/Agent/Entries">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <partial name="~/Components/_DataTable.cshtml" model="dataTable" />
}