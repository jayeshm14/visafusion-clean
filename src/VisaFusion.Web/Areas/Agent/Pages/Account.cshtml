@page
@model VisaFusion.Web.Areas.Agent.Pages.AccountModel
@using VisaFusion.Web.Components
@{
    ViewData["Title"] = "My account";
    ViewData["UseSidebar"] = true;

    var formCard = new FormCardModel
    {
        Id = "account-form",
        Title = "My account",
        Subtitle = "Update your agent profile details",
        CardClass = "shadow-sm",
        Form = new FormCardForm
        {
            Id = "account-form",
            Method = "post",
            AntiForgeryToken = Html.AntiForgeryToken()
        },
        Sections = new List<FormCardSection>
        {
            new()
            {
                Title = "Company",
                Fields = new List<FormField>
                {
                    new() { Name = "Companyname", Label = "Company name", Type = FormFieldType.Text, Value = Model.Companyname ?? string.Empty, Required = true },
                    new() { Name = "Description", Label = "Description", Type = FormFieldType.Text, Value = Model.Description ?? string.Empty }
                }
            },
            new()
            {
                Title = "Address",
                Fields = new List<FormField>
                {
                    new() { Name = "Street1", Label = "Address line 1", Type = FormFieldType.Text, Value = Model.Street1 ?? string.Empty },
                    new() { Name = "Street2", Label = "Address line 2", Type = FormFieldType.Text, Value = Model.Street2 ?? string.Empty },
                    new() { Name = "Area", Label = "Area", Type = FormFieldType.Text, Value = Model.Area ?? string.Empty },
                    new() { Name = "City", Label = "City", Type = FormFieldType.Text, Value = Model.City ?? string.Empty },
                    new() { Name = "Pincode", Label = "Pincode", Type = FormFieldType.Text, Value = Model.Pincode ?? string.Empty }
                }
            },
            new()
            {
                Title = "Contact",
                Fields = new List<FormField>
                {
                    new() { Name = "Phoneno", Label = "Phone", Type = FormFieldType.Text, Value = Model.Phoneno ?? string.Empty },
                    new() { Name = "Faxno", Label = "Fax", Type = FormFieldType.Text, Value = Model.Faxno ?? string.Empty },
                    new() { Name = "Emailid", Label = "Email", Type = FormFieldType.Email, Value = Model.Emailid ?? string.Empty },
                    new() { Name = "Smsno", Label = "SMS number", Type = FormFieldType.Text, Value = Model.Smsno ?? string.Empty }
                }
            },
            new()
            {
                Title = "People",
                Fields = new List<FormField>
                {
                    new() { Name = "Directorname", Label = "Director name", Type = FormFieldType.Text, Value = Model.Directorname ?? string.Empty },
                    new() { Name = "DirectorPH", Label = "Director phone", Type = FormFieldType.Text, Value = Model.DirectorPH ?? string.Empty },
                    new() { Name = "AcMgrPH", Label = "Accounts manager phone", Type = FormFieldType.Text, Value = Model.AcMgrPH ?? string.Empty },
                    new() { Name = "VisaInchargeName", Label = "Visa in-charge name", Type = FormFieldType.Text, Value = Model.VisaInchargeName ?? string.Empty },
                    new() { Name = "VisaInchargePH", Label = "Visa in-charge phone", Type = FormFieldType.Text, Value = Model.VisaInchargePH ?? string.Empty }
                }
            },
            new()
            {
                Title = "Financial",
                Fields = new List<FormField>
                {
                    new() { Name = "Acno", Label = "Account no.", Type = FormFieldType.Text, Value = Model.Acno ?? string.Empty },
                    new() { Name = "Payment", Label = "Payment", Type = FormFieldType.Text, Value = Model.Payment ?? string.Empty }
                }
            },
            new()
            {
                Title = "Memberships",
                Fields = new List<FormField>
                {
                    new() { Name = "TAAI", Label = "TAAI", Type = FormFieldType.Text, Value = Model.TAAI ?? string.Empty },
                    new() { Name = "TAFI", Label = "TAFI", Type = FormFieldType.Text, Value = Model.TAFI ?? string.Empty },
                    new() { Name = "Membership", Label = "Membership", Type = FormFieldType.Text, Value = Model.Membership ?? string.Empty },
                    new() { Name = "IATA", Label = "IATA", Type = FormFieldType.Text, Value = Model.IATA ?? string.Empty }
                }
            }
        },
        FooterActions = new List<FormCardAction>
        {
            new() { Title = "Save", Type = FormCardActionType.Submit, CssClass = "btn-primary" },
            new() { Title = "Cancel", Type = FormCardActionType.Link, Url = "/Agent/Index", CssClass = "btn-outline-secondary" }
        }
    };
}

@if (Model.HasNoLinkedAgent)
{
    <div class="alert alert-danger" role="alert">
        This account has no linked agent (CHK026). Contact the office to have
        an agent bound to this login before using the portal.
    </div>
}
else if (Model.IsNotFound)
{
    <div class="alert alert-danger" role="alert">
        The linked agent record could not be found.
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Model.OutcomeMessage))
    {
        <div class="alert alert-success" role="status">@Model.OutcomeMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.OutcomeError))
    {
        <div class="alert alert-danger" role="alert">@Model.OutcomeError</div>
    }

    <partial name="~/Components/_FormCard.cshtml" model="formCard" />
}