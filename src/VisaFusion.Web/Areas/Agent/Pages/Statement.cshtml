@page
@model VisaFusion.Web.Areas.Agent.Pages.StatementModel
@{
    ViewData["Title"] = "Statement";
    ViewData["UseSidebar"] = true;
}

@if (Model.HasNoLinkedAgent)
{
    <div class="alert alert-danger" role="alert">
        This account has no linked agent (CHK026). Contact the office to have
        an agent bound to this login before using the portal.
    </div>
}
else
{
    <div class="card shadow-sm">
        @if (Model.Result!.Items.Count == 0)
        {
            <div class="card-body">
                <p class="mb-0">No ledger entries for this agent.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Type</th>
                            <th scope="col">Ref no.</th>
                            <th scope="col">Passenger</th>
                            <th scope="col">Voucher</th>
                            <th scope="col" class="text-end">Debit</th>
                            <th scope="col" class="text-end">Credit</th>
                            <th scope="col" class="text-end">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Result.Items)
                        {
                            <tr>
                                <td>@(line.Date?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(line.TransactionType) ? "—" : line.TransactionType)</td>
                                <td>@(line.Refno?.ToString() ?? "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(line.Paxname) ? "—" : line.Paxname)</td>
                                <td>@(string.IsNullOrWhiteSpace(line.Reftype) ? "—" : line.Reftype + (line.Invno.HasValue ? "/" + line.Invno : ""))</td>
                                <td class="text-end">@(line.Debit?.ToString("N2") ?? "—")</td>
                                <td class="text-end">@(line.Credit?.ToString("N2") ?? "—")</td>
                                <td class="text-end">@(line.Balance?.ToString("N2") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light">
                            <th scope="row" colspan="5">Totals</th>
                            <td class="text-end">@(Model.Result.TotalDebits?.ToString("N2") ?? "—")</td>
                            <td class="text-end">@(Model.Result.TotalCredits?.ToString("N2") ?? "—")</td>
                            <td class="text-end">@(Model.Result.Balance?.ToString("N2") ?? "—")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
}