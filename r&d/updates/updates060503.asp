                        </font></td>
                    </tr>
                    <tr> 
                      <td width="4%" valign="top" height="2"><b><font face="Arial" size="2">6.</font></b></td>
                      <td width="96%" height="2"><font face="Arial" size="2">CERTIFICATE 
                        IN ORIGINAL FROM THE CURRENT EMPLOYER.</font></td>
                    </tr>
